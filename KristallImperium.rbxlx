	Font = Enum.Font.GothamBold,
	TextColor3 = C.cyan,
	Text = "0 pro Sekunde",
}, top)

local frenzyBanner = text({
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 1, 8),
	Size = UDim2.fromOffset(380, 38),
	BackgroundTransparency = 0,
	BackgroundColor3 = C.orange,
