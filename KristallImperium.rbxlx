	Size = UDim2.fromOffset(440, 100),
	BackgroundColor3 = C.panel,
	BackgroundTransparency = 0.1,
}, gui)
corner(top, 18)
stroke(top, C.cyan, 2, 0.4)
autoScale(top)

local crystalLabel = text({
	Position = UDim2.fromOffset(12, 6),
	Size = UDim2.new(1, -24, 0, 54),
