	BackgroundColor3 = C.red,
	Text = "X",
}, shop)
closeShop.Activated:Connect(function()
	shop.Visible = false
	shopToggle.Visible = true
end)
shopToggle.Activated:Connect(function()
	shop.Visible = true
	shopToggle.Visible = false
end)

-- Reiter
local tabs = {}
local pages = {}
local currentTab = "gens"
local TAB_DEFS = { { id = "gens", label = "⛏️ Helfer" }, { id = "upgrades", label = "⚡ Upgrades" }, { id = "rebirth", label = "🌟 Rebirth" } }

local tabRow = create("Frame", { Size = UDim2.new(1, -44, 0, 36), BackgroundTransparency = 1 }, shop)
create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }, tabRow)

local function selectTab(id)
	currentTab = id
	for tabId, tab in tabs do
		tab.BackgroundColor3 = (tabId == id) and C.purple or C.card
	end
	for pageId, page in pages do
		page.Visible = pageId == id
	end
end

for _, def in TAB_DEFS do
	local tab = button({ Size = UDim2.new(1 / 3, -4, 1, 0), BackgroundColor3 = C.card, Text = def.label, Font = Enum.Font.GothamBold }, tabRow)
	create("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8) }, tab)
	tabs[def.id] = tab
	tab.Activated:Connect(function()
		selectTab(def.id)
	end)
end

local function makePage(id, topOffset)
	local page = create("ScrollingFrame", {
		Position = UDim2.fromOffset(0, topOffset),
		Size = UDim2.new(1, 0, 1, -topOffset),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.purple,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
	}, shop)
	create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, page)
	create("UIPadding", { PaddingRight = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10) }, page)
	pages[id] = page
	return page
end

-- Menge x1 / x10 / Max (nur Helfer-Reiter)
local buyAmount = 1
local amountRow = create("Frame", { Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1 }, shop)
create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Right }, amountRow)
text({ Size = UDim2.new(0, 90, 0.8, 0), Text = "Menge:", TextColor3 = C.muted, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Right }, amountRow)
local amountButtons = {}
for _, amount in { 1, 10, "max" } do
	local b = button({ Size = UDim2.fromOffset(64, 30), BackgroundColor3 = C.card, Text = amount == "max" and "Max" or ("x" .. amount), Font = Enum.Font.GothamBold }, amountRow)
	create("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) }, b)
	amountButtons[amount] = b
	b.Activated:Connect(function()
		buyAmount = amount
		for a, other in amountButtons do
			other.BackgroundColor3 = (a == amount) and C.cyan or C.card
		end
	end)
end
amountButtons[1].BackgroundColor3 = C.cyan

local genPage = makePage("gens", 82)
local upgradePage = makePage("upgrades", 44)
local rebirthPage = makePage("rebirth", 44)

local function updateAmountRowVisibility()
	amountRow.Visible = currentTab == "gens"
end

-- Kaufen
local busy = false
local function purchase(kind, id, amount)
	if busy then
		return
	end
	busy = true
	local ok, success, message = pcall(buyFunction.InvokeServer, buyFunction, kind, id, amount)
	busy = false
	if ok and success then
		play("buy")
		toast(message, "build")
	else
		toast(ok and message or "Kauf fehlgeschlagen.", "error")
	end
end

-- Zeilen für Helfer
local genRows = {}
for index, gen in Config.GENERATORS do
	local row = create("Frame", { LayoutOrder = index, Size = UDim2.new(1, 0, 0, 96), BackgroundColor3 = C.card }, genPage)
	corner(row, 12)
	local icon = text({ Position = UDim2.fromOffset(8, 18), Size = UDim2.fromOffset(56, 56), Font = Enum.Font.GothamBold }, row)
	local name = text({ Position = UDim2.fromOffset(72, 8), Size = UDim2.new(1, -200, 0, 24), Font = Enum.Font.FredokaOne, TextXAlignment = Enum.TextXAlignment.Left }, row)
	local detail = text({ Position = UDim2.fromOffset(72, 36), Size = UDim2.new(1, -200, 0, 16), Font = Enum.Font.GothamMedium, TextColor3 = C.muted, TextXAlignment = Enum.TextXAlignment.Left }, row)
	local setBar, bar = progressBar({ Position = UDim2.fromOffset(72, 62), Size = UDim2.new(1, -200, 0, 22) }, row, C.gold)
	local buy = button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(112, 76), Text = "" }, row)
	local buyTop = text({ Position = UDim2.fromOffset(4, 8), Size = UDim2.new(1, -8, 0, 22), Font = Enum.Font.FredokaOne, Text = "Kaufen" }, buy)
	local buyCost = text({ Position = UDim2.fromOffset(4, 36), Size = UDim2.new(1, -8, 0, 30), Font = Enum.Font.FredokaOne }, buy)
	buy.Activated:Connect(function()
		purchase("gen", gen.id, buyAmount)
	end)
	genRows[gen.id] = { row = row, icon = icon, name = name, detail = detail, setBar = setBar, bar = bar, buy = buy, buyTop = buyTop, buyCost = buyCost, index = index }
end

-- Zeilen für Upgrades
local function simpleRow(parent, order, iconText, title, desc, onBuy)
	local row = create("Frame", { LayoutOrder = order, Size = UDim2.new(1, 0, 0, 74), BackgroundColor3 = C.card }, parent)
	corner(row, 12)
	text({ Position = UDim2.fromOffset(8, 12), Size = UDim2.fromOffset(50, 50), Text = iconText, Font = Enum.Font.GothamBold }, row)
	local titleLabel = text({ Position = UDim2.fromOffset(66, 10), Size = UDim2.new(1, -190, 0, 24), Text = title, Font = Enum.Font.FredokaOne, TextXAlignment = Enum.TextXAlignment.Left }, row)
	local descLabel = text({ Position = UDim2.fromOffset(66, 38), Size = UDim2.new(1, -190, 0, 26), Text = desc, Font = Enum.Font.GothamMedium, TextColor3 = C.muted, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true }, row)
	local buy = button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(112, 54), Font = Enum.Font.FredokaOne }, row)
	create("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) }, buy)
	buy.Activated:Connect(onBuy)
	return { row = row, title = titleLabel, desc = descLabel, buy = buy }
end

local upgradeRows = {}
for index, upgrade in Config.UPGRADES do
	upgradeRows[upgrade.id] = simpleRow(upgradePage, index, upgrade.icon, upgrade.name, upgrade.desc, function()
		purchase("upgrade", upgrade.id)
	end)
	upgradeRows[upgrade.id].index = index
end

-- Rebirth-Seite
local rebirthCard = create("Frame", { LayoutOrder = 0, Size = UDim2.new(1, 0, 0, 250), BackgroundColor3 = Color3.fromRGB(44, 34, 80) }, rebirthPage)
corner(rebirthCard, 14)
stroke(rebirthCard, C.gold, 2, 0.3)
padding(rebirthCard, 12)
text({ Size = UDim2.new(1, 0, 0, 30), Text = "🌟 Wiedergeburt", Font = Enum.Font.FredokaOne, TextColor3 = C.gold }, rebirthCard)
text({
	Position = UDim2.fromOffset(0, 36),
	Size = UDim2.new(1, 0, 0, 54),
	Font = Enum.Font.GothamMedium,
	TextColor3 = C.muted,
	TextWrapped = true,
	Text = "Fang neu an und bekomme <b>Sternenstaub</b>: +" .. math.floor(Config.STARDUST_BONUS * 100)
		.. " % Produktion pro Stück für immer! Deine Insel und der Sternen-Shop bleiben erhalten.",
}, rebirthCard)
local rebirthGainLabel = text({ Position = UDim2.fromOffset(0, 96), Size = UDim2.new(1, 0, 0, 28), Font = Enum.Font.FredokaOne }, rebirthCard)
local setRebirthBar = progressBar({ Position = UDim2.fromOffset(0, 130), Size = UDim2.new(1, 0, 0, 22) }, rebirthCard, C.gold)
local rebirthButton = button({ Position = UDim2.fromOffset(0, 162), Size = UDim2.new(1, 0, 0, 60), BackgroundColor3 = C.gold, TextColor3 = Color3.fromRGB(60, 40, 0) }, rebirthCard)
create("UIPadding", { PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12) }, rebirthButton)

local starHeader = text({ LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 34), Font = Enum.Font.FredokaOne, TextColor3 = C.gold }, rebirthPage)
local starRows = {}
for index, upgrade in Config.STAR_UPGRADES do
	starRows[upgrade.id] = simpleRow(rebirthPage, 10 + index, upgrade.icon, upgrade.name, upgrade.desc, function()
		purchase("star", upgrade.id)
	end)
end

local confirmUntil = 0
rebirthButton.Activated:Connect(function()
	if not state or Config.stardustForRun(state.runTotal) < 1 then
		toast("Sammle erst " .. format(Config.REBIRTH_BASE) .. " 💎 in dieser Runde.", "error")
		return
	end
	if os.clock() > confirmUntil then
		confirmUntil = os.clock() + 3
		toast("Sicher? Klick nochmal zum Bestätigen!", "info")
		return
	end
	confirmUntil = 0
	local ok, success, message = pcall(rebirthFunction.InvokeServer, rebirthFunction)
	if ok and success then
		play("big")
		toast(message, "frenzy")
	else
		toast(ok and message or "Wiedergeburt fehlgeschlagen.", "error")
	end
end)

selectTab("gens")
for _, tab in tabs do
	tab.Activated:Connect(updateAmountRowVisibility)
end

---------------------------------------------------------------------------
-- Anzeige aktualisieren
---------------------------------------------------------------------------

local function setBuyable(b, affordable)
	b.BackgroundColor3 = affordable and C.green or C.grey
	b.AutoButtonColor = affordable
end

local function refreshShop()
	if not state then
		return
	end
	local money = currentCrystals()

	-- Helfer
	for index, gen in Config.GENERATORS do
		local r = genRows[gen.id]
		local owned = state.gens[gen.id] or 0
		local unlocked = index == 1 or (state.gens[Config.GENERATORS[index - 1].id] or 0) > 0
		local previousVisible = index <= 2 or (state.gens[Config.GENERATORS[index - 2].id] or 0) > 0
		r.row.Visible = unlocked or previousVisible
		r.row.BackgroundColor3 = unlocked and C.card or C.cardLocked
		r.bar.Visible = unlocked
		r.buy.Visible = unlocked
		if unlocked then
			r.icon.Text = gen.icon
			r.name.Text = gen.name .. '  <font color="' .. hex(C.gold) .. '">x' .. owned .. "</font>"
			local unit = Config.unitRate(state, gen)
			r.detail.Text = "+" .. format(unit) .. "/s pro Stück  •  " .. format(unit * owned) .. "/s gesamt"

			local nextMilestone = Config.nextMilestone(owned)
			if nextMilestone then
				local previous = 0
				for _, t in Config.MILESTONES do
					if t < nextMilestone then
						previous = t
					end
				end
				r.setBar((owned - previous) / (nextMilestone - previous), "Meilenstein " .. owned .. "/" .. nextMilestone .. " → Produktion x2")
			else
				r.setBar(1, "Alle Meilensteine erreicht! 🏆")
			end

			local count = buyAmount == "max" and math.max(1, Config.maxAffordable(gen, owned, money, state)) or buyAmount
			local cost = Config.generatorCost(gen, owned, count, state)
			r.buyTop.Text = "Kaufen x" .. count
			r.buyCost.Text = "💎 " .. format(cost)
			setBuyable(r.buy, money >= cost)
		else
			r.icon.Text = "❓"
			r.name.Text = "???"
			r.detail.Text = "Kauf zuerst den Helfer darüber."
		end
	end

	-- Upgrades
	for index, upgrade in Config.UPGRADES do
		local r = upgradeRows[upgrade.id]
		if state.upgrades[upgrade.id] then
			r.row.LayoutOrder = 1000 + index
			r.row.BackgroundTransparency = 0.5
			r.buy.Text = "✓ Gekauft"
			r.buy.BackgroundColor3 = C.grey
			r.buy.AutoButtonColor = false
		else
			r.row.LayoutOrder = index
			r.row.BackgroundTransparency = 0
			r.buy.Text = "💎 " .. format(upgrade.cost)
			setBuyable(r.buy, money >= upgrade.cost)
		end
	end

	-- Wiedergeburt
	local gain = Config.stardustForRun(state.runTotal)
	local nextTotal = Config.runTotalForStardust(gain + 1)
	local prevTotal = Config.runTotalForStardust(gain)
	rebirthGainLabel.Text = "Du bekommst: <font color=\"" .. hex(C.gold) .. "\">+" .. gain .. " ✨</font>"
	setRebirthBar((state.runTotal - prevTotal) / (nextTotal - prevTotal), format(state.runTotal) .. " / " .. format(nextTotal) .. " für +" .. (gain + 1))
	rebirthButton.Text = gain >= 1 and ("🌟 Wiedergeburt (+" .. gain .. " ✨)") or "🔒 Noch nicht bereit"
	rebirthButton.BackgroundColor3 = gain >= 1 and C.gold or C.grey
	tabs.rebirth.TextColor3 = gain >= 1 and C.gold or Color3.new(1, 1, 1)

	local available = Config.availableStardust(state)
	starHeader.Text = "✨ Sternen-Shop  (verfügbar: " .. available .. ")"
	for _, upgrade in Config.STAR_UPGRADES do
		local r = starRows[upgrade.id]
		local level = Config.starLevel(state, upgrade.id)
		r.title.Text = upgrade.name .. '  <font color="' .. hex(C.gold) .. '">' .. level .. "/" .. upgrade.maxLevel .. "</font>"
		if level >= upgrade.maxLevel then
			r.buy.Text = "MAX"
			r.buy.BackgroundColor3 = C.grey
		else
			local cost = Config.starUpgradeCost(upgrade, level)
			r.buy.Text = "✨ " .. format(cost)
			setBuyable(r.buy, available >= cost)
		end
	end

	-- Insel und Sternenstaub links
	local level = Config.islandLevel(state.allTime)
	local levels = Config.ISLAND_LEVELS
	islandTitle.Text = "🏗️ Insel-Stufe " .. level .. "/" .. #levels
	if level < #levels then
		local nextLevel = levels[level + 1]
		local prev = level > 0 and levels[level].total or 0
		islandNext.Text = "Nächster Ausbau: <b>" .. nextLevel.name .. "</b>"
		setIslandBar((state.allTime - prev) / (nextLevel.total - prev), format(state.allTime) .. " / " .. format(nextLevel.total))
	else
		islandNext.Text = "Deine Insel ist komplett ausgebaut! 👑"
		setIslandBar(1, format(state.allTime))
	end
	stardustLabel.Text = "✨ " .. state.stardust .. " Sternenstaub  (+" .. math.floor(state.stardust * Config.STARDUST_BONUS * 100) .. " %)"
end

stateEvent.OnClientEvent:Connect(function(newState)
	state = newState
	stateClock = os.clock()
end)

---------------------------------------------------------------------------
-- Kristall klicken
---------------------------------------------------------------------------

local punchStart = {}

local function punchCrystal(crystal)
	punchStart[crystal] = os.clock()
	local core = crystal:FindFirstChild("Core")
	local burst = core and core:FindFirstChild("Burst")
	if burst then
		burst:Emit(8)
	end
end

local function myCrystal()
	local plots = workspace:FindFirstChild("Plots")
	if not plots then
		return nil
	end
	for _, plot in plots:GetChildren() do
		if plot:GetAttribute("OwnerId") == player.UserId then
			return plot:FindFirstChild("Crystal")
		end
	end
	return nil
end

local function mine(screenPos)
	if not state or clientTokens < 1 then
		return
	end
	clientTokens -= 1
	mineEvent:FireServer()
	local value = Config.clickValue(state) * frenzyMult()
	state.crystals += value
	state.runTotal += value
	state.allTime += value
	popup("+" .. format(value), screenPos, frenzyMult() > 1 and C.orange or C.cyan)
	play("click")
	local crystal = myCrystal()
	if crystal then
		punchCrystal(crystal)
	end
end

mineButton.Activated:Connect(function()
	local pos = mineButton.AbsolutePosition + mineButton.AbsoluteSize / 2
	mine(Vector2.new(pos.X, pos.Y - 50))
end)

local function hookCrystal(crystal)
	local detector = crystal:WaitForChild("ClickDetector", 10)
	if not detector then
		return
	end
	detector.MouseClick:Connect(function()
		local plot = crystal.Parent
		if plot and plot:GetAttribute("OwnerId") == player.UserId then
			mine(UserInputService:GetMouseLocation())
		else
			toast("Das ist nicht deine Insel! 🏝️", "error")
		end
	end)
end
for _, crystal in CollectionService:GetTagged("MainCrystal") do
	task.spawn(hookCrystal, crystal)
end
CollectionService:GetInstanceAddedSignal("MainCrystal"):Connect(hookCrystal)

---------------------------------------------------------------------------
-- Animationen: Kristalle schweben, Helfer drehen sich
---------------------------------------------------------------------------

local spinning = {}
local function trackModel(model)
	if model:IsA("Model") then
		spinning[model] = { pivot = model:GetPivot(), offset = math.random() * 10 }
	end
end
for _, model in CollectionService:GetTagged("GenModel") do
	trackModel(model)
end
CollectionService:GetInstanceAddedSignal("GenModel"):Connect(trackModel)
CollectionService:GetInstanceRemovedSignal("GenModel"):Connect(function(model)
	spinning[model] = nil
end)

local goldens = {}
local function trackGolden(model)
	goldens[model] = model:GetPivot()
end
CollectionService:GetInstanceAddedSignal("Golden"):Connect(trackGolden)
CollectionService:GetInstanceRemovedSignal("Golden"):Connect(function(model)
	goldens[model] = nil
end)
for _, model in CollectionService:GetTagged("Golden") do
	trackGolden(model)
end

RunService.RenderStepped:Connect(function(dt)
	local t = os.clock()
	clientTokens = math.min(Config.CLICKS_PER_SECOND, clientTokens + Config.CLICKS_PER_SECOND * dt)

	for _, crystal in CollectionService:GetTagged("MainCrystal") do
		local base = crystal:GetAttribute("BaseCFrame")
		local baseScale = crystal:GetAttribute("BaseScale")
		if typeof(base) == "CFrame" and type(baseScale) == "number" and crystal:IsA("Model") then
			-- kurzes "Aufploppen" nach einem Klick
			local since = punchStart[crystal] and (t - punchStart[crystal]) or 1
			local pop = since < 0.25 and math.sin(since / 0.25 * math.pi) * 0.12 or 0
			local target = baseScale * (1 + pop)
			if math.abs(crystal:GetScale() - target) > 0.001 then
				crystal:ScaleTo(target)
			end
			crystal:PivotTo(CFrame.new(0, math.sin(t * 1.5) * 0.6, 0) * base * CFrame.Angles(0, t * 0.5, 0))
			-- Regenbogen-Skin: Farbe wandert durch alle Farben
			if crystal:GetAttribute("Rainbow") then
				local color = Color3.fromHSV((t * 0.15) % 1, 0.75, 1)
				for _, part in crystal:GetChildren() do
					if part:IsA("BasePart") then
						part.Color = color
					end
				end
			end
		end
	end
	for model, info in spinning do
		if model.Parent then
			model:PivotTo(info.pivot * CFrame.new(0, math.sin(t * 2 + info.offset) * 0.25, 0) * CFrame.Angles(0, t * 0.6 + info.offset, 0))
		end
	end
	for model, base in goldens do
		if model.Parent then
			model:PivotTo(base * CFrame.new(0, math.sin(t * 3) * 0.6, 0) * CFrame.Angles(0, t * 2, 0))
		end
	end

	if state then
		crystalLabel.Text = "💎 " .. format(math.floor(currentCrystals()))
		perSecondLabel.Text = "+" .. format(perSecond()) .. " pro Sekunde"
		mineValue.Text = "+" .. format(Config.clickValue(state) * frenzyMult()) .. " pro Klick"
		local left = frenzyLeft()
		local like = likeLeft()
		frenzyBanner.Visible = left > 0 or like > 0
		if left > 0 then
			frenzyBanner.BackgroundColor3 = C.orange
			frenzyBanner.Text = "🔥 KRISTALLRAUSCH x" .. Config.FRENZY_MULTIPLIER .. "  –  " .. math.ceil(left) .. "s"
		elseif like > 0 then
			frenzyBanner.BackgroundColor3 = Color3.fromRGB(230, 60, 110)
			frenzyBanner.Text = string.format("❤️ Like-Boost +25 %%  –  %d:%02d", math.floor(like / 60), math.floor(like % 60))
		end
	end
end)

-- Shop regelmäßig aktualisieren
task.spawn(function()
	while true do
		refreshShop()
		task.wait(0.15)
	end
end)

local function updateScale()
	local camera = workspace.CurrentCamera
	local height = camera and camera.ViewportSize.Y or 900
	local scale = math.clamp(height / 900, 0.55, 1.15)
	for _, s in scaled do
		s.Scale = scale
	end
	-- Der Shop füllt immer die ganze Bildschirmhöhe aus
	shopScale.Scale = scale
	shop.Size = UDim2.fromOffset(400, (height - 76) / scale)
end

if workspace.CurrentCamera then
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
end
updateScale()
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX0000000000000000000000000000000E"><Properties><string name="Name">Extras</string><ProtectedString name="Source"><![CDATA[-- Kristall-Imperium: Menü, Haustiere, Glücksrad, Tägliche Belohnung, Casino, Skins,
-- Robux-Shop, Golem-Anzeige und Haustiere, die den Spielern folgen.

local CollectionService = game:GetService("CollectionService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local stateEvent = remotes:WaitForChild("State")
local petAction = remotes:WaitForChild("PetAction")
local claimDaily = remotes:WaitForChild("ClaimDaily")
local spinWheel = remotes:WaitForChild("SpinWheel")
local playSlots = remotes:WaitForChild("PlaySlots")
local skinRemote = remotes:WaitForChild("Skin")
local teleport = remotes:WaitForChild("Teleport")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local toastBindable = playerGui:WaitForChild("KristallToast")
local format = Config.format

local function toast(message, kind)
	toastBindable:Fire(message, kind)
end

local state = nil
stateEvent.OnClientEvent:Connect(function(newState)
	state = newState
end)

-- Farben und UI-Helfer ----------------------------------------------------

local C = {
	panel = Color3.fromRGB(18, 20, 38),
	card = Color3.fromRGB(34, 38, 66),
	text = Color3.fromRGB(240, 244, 255),
	muted = Color3.fromRGB(160, 168, 200),
	cyan = Color3.fromRGB(90, 200, 255),
	gold = Color3.fromRGB(255, 205, 60),
	green = Color3.fromRGB(60, 200, 110),
	grey = Color3.fromRGB(80, 84, 110),
	purple = Color3.fromRGB(170, 110, 255),
	red = Color3.fromRGB(230, 70, 80),
	pink = Color3.fromRGB(255, 80, 140),
}

local function create(className, props, parent)
	local inst = Instance.new(className)
	for key, value in props do
		inst[key] = value
	end
	inst.Parent = parent
	return inst
end

local function corner(parent, radius)
	create("UICorner", { CornerRadius = UDim.new(0, radius or 12) }, parent)
end

local function stroke(parent, color, thickness, transparency)
	return create("UIStroke", {
		Color = color,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

local function text(props, parent)
	local base = {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextColor3 = C.text,
		TextScaled = true,
		RichText = true,
	}
	for key, value in props do
		base[key] = value
	end
	return create("TextLabel", base, parent)
end

local function button(props, parent)
	local base = {
		Font = Enum.Font.FredokaOne,
		TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true,
		AutoButtonColor = true,
		BackgroundColor3 = C.green,
	}
	for key, value in props do
		base[key] = value
	end
	local b = create("TextButton", base, parent)
	corner(b, 10)
	return b
end

local function pad(parent, px)
	create("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
	}, parent)
end

local function hex(color)
	local function byte(x)
		return math.clamp(math.floor(x * 255 + 0.5), 0, 255)
	end
	return string.format("#%02X%02X%02X", byte(color.R), byte(color.G), byte(color.B))
end

local function clock(seconds)
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d:%02d", seconds // 3600, (seconds % 3600) // 60, seconds % 60)
end

local function serverNow()
	return workspace:GetServerTimeNow()
end

local gui = create("ScreenGui", {
	Name = "KristallExtras",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	DisplayOrder = 5,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, playerGui)

local scaled = {}
local function autoScale(guiObject)
	table.insert(scaled, create("UIScale", {}, guiObject))
end

---------------------------------------------------------------------------
-- Fenster-System
---------------------------------------------------------------------------

local window = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(620, 470),
	BackgroundColor3 = C.panel,
	Visible = false,
	ZIndex = 10,
}, gui)
corner(window, 18)
stroke(window, C.purple, 3, 0.2)
autoScale(window)
local windowTitle = text({
	Position = UDim2.fromOffset(16, 10),
	Size = UDim2.new(1, -80, 0, 36),
	Font = Enum.Font.FredokaOne,
	TextXAlignment = Enum.TextXAlignment.Left,
	ZIndex = 11,
}, window)
local closeButton = button({
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -10, 0, 10),
	Size = UDim2.fromOffset(38, 38),
	BackgroundColor3 = C.red,
	Text = "X",
	ZIndex = 11,
}, window)
local content = create("Frame", {
	Position = UDim2.fromOffset(14, 56),
	Size = UDim2.new(1, -28, 1, -70),
	BackgroundTransparency = 1,
	ZIndex = 11,
}, window)

local currentWindow = nil
local windowRefresh = nil
local WINDOWS = {}

local function closeWindow()
	window.Visible = false
	currentWindow = nil
	windowRefresh = nil
	content:ClearAllChildren()
end
closeButton.Activated:Connect(closeWindow)

local function openWindow(id, extra)
	local def = WINDOWS[id]
	if not def then
		return
	end
	content:ClearAllChildren()
	windowTitle.Text = def.title
	currentWindow = id
	windowRefresh = def.build(content, extra)
	window.Visible = true
	if windowRefresh and state then
		windowRefresh()
	end
end

-- Alle Elemente im Fenster liegen über dem restlichen HUD
local function z(inst)
	if inst:IsA("GuiObject") then
		inst.ZIndex = 12
	end
	for _, child in inst:GetDescendants() do
		if child:IsA("GuiObject") then
			child.ZIndex = 12
		end
	end
	return inst
end

local function scroller(parent, props)
	local base = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.purple,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
	}
	for key, value in props do
		base[key] = value
	end
	return create("ScrollingFrame", base, parent)
end

local busy = false
local function invoke(remote, ...)
	if busy then
		return false, "Moment..."
	end
	busy = true
	local results = table.pack(pcall(remote.InvokeServer, remote, ...))
	busy = false
	if not results[1] then
		return false, "Verbindungsfehler, versuch es nochmal."
	end
	return table.unpack(results, 2, results.n)
end

---------------------------------------------------------------------------
-- Haustiere
---------------------------------------------------------------------------

local function rarityColor(pet)
	return Config.RARITIES[pet.rarity].color
end

local function petLabel(entry)
	local pet, golden = Config.parsePet(entry)
	if not pet then
		return "?", "?"
	end
	return pet.icon, (golden and "⭐ " or "") .. pet.name
end

WINDOWS.pets = {
	title = "🐾 Haustiere",
	build = function(root, eggId)
		local tab = eggId and "eggs" or "inventory"
		local releaseMode = false
		local lastSignature = ""

		local tabRow = create("Frame", { Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1 }, root)
		create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }, tabRow)
		local eggTab = button({ Size = UDim2.fromOffset(150, 36), Text = "🥚 Eier", BackgroundColor3 = C.card }, tabRow)
		local invTab = button({ Size = UDim2.fromOffset(220, 36), Text = "🎒 Inventar", BackgroundColor3 = C.card }, tabRow)
		pad(eggTab, 6)
		pad(invTab, 6)

		local eggPage = create("Frame", { Position = UDim2.fromOffset(0, 46), Size = UDim2.new(1, 0, 1, -46), BackgroundTransparency = 1 }, root)
		local invPage = create("Frame", { Position = UDim2.fromOffset(0, 46), Size = UDim2.new(1, 0, 1, -46), BackgroundTransparency = 1 }, root)

		-- Schlüpf-Animation
		local hatchOverlay = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.panel, Visible = false }, root)
		corner(hatchOverlay, 14)
		local hatchIcon = text({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.4), Size = UDim2.fromOffset(160, 160), Font = Enum.Font.GothamBold }, hatchOverlay)
		local hatchName = text({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.68), Size = UDim2.fromOffset(460, 40), Font = Enum.Font.FredokaOne }, hatchOverlay)
		local hatchInfo = text({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.8), Size = UDim2.fromOffset(460, 28), Font = Enum.Font.GothamBold, TextColor3 = C.muted }, hatchOverlay)

		local function playHatch(egg, petId)
			hatchOverlay.Visible = true
			hatchName.Text = "..."
			hatchInfo.Text = ""
			hatchIcon.Text = egg.icon
			hatchIcon.Rotation = 0
			for i = 1, 8 do
				hatchIcon.Rotation = (i % 2 == 0) and 15 or -15
				task.wait(0.09 + i * 0.015)
			end
			hatchIcon.Rotation = 0
			local pet = Config.PETS_BY_ID[petId]
			hatchIcon.Text = pet.icon
			hatchIcon.Size = UDim2.fromOffset(60, 60)
			TweenService:Create(hatchIcon, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(160, 160) }):Play()
			local rarity = Config.RARITIES[pet.rarity]
			hatchName.Text = pet.name .. '  <font color="' .. hex(rarity.color) .. '">(' .. rarity.name .. ")</font>"
			hatchInfo.Text = "+" .. math.floor(pet.boost * 100) .. " % Produktion & Klicks"
			task.wait(2.2)
			hatchOverlay.Visible = false
		end

		-- Eier-Seite
		local eggList = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, eggPage)
		create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10) }, eggList)
		local eggButtons = {}
		for _, egg in Config.EGGS do
			local card = create("Frame", { Size = UDim2.new(1 / 3, -7, 1, 0), BackgroundColor3 = C.card }, eggList)
			corner(card, 14)
			stroke(card, egg.color, 2, 0.3)
			text({ Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 50), Text = egg.icon }, card)
			text({ Position = UDim2.fromOffset(6, 60), Size = UDim2.new(1, -12, 0, 24), Text = egg.name, Font = Enum.Font.FredokaOne }, card)
			local lines = {}
			for _, option in egg.pets do
				local pet = Config.PETS_BY_ID[option.pet]
				table.insert(lines, pet.icon .. ' <font color="' .. hex(rarityColor(pet)) .. '">' .. pet.name .. "</font>  " .. option.chance .. " %")
			end
			text({
				Position = UDim2.fromOffset(8, 90),
				Size = UDim2.new(1, -16, 1, -150),
				Text = table.concat(lines, "\n"),
				Font = Enum.Font.GothamMedium,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
			}, card)
			local buy = button({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Size = UDim2.new(1, -16, 0, 44), Text = "💎 " .. format(egg.cost) }, card)
			pad(buy, 8)
			eggButtons[egg.id] = buy
			buy.Activated:Connect(function()
				local ok, result = invoke(petAction, "hatch", egg.id)
				if ok then
					task.spawn(playHatch, egg, result)
				else
					toast(result, "error")
				end
			end)
		end

		-- Inventar-Seite
		local info = text({ Size = UDim2.new(1, 0, 0, 24), Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left }, invPage)
		local actionRow = create("Frame", { Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1 }, invPage)
		create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }, actionRow)
		local bestButton = button({ Size = UDim2.fromOffset(180, 36), Text = "⭐ Beste ausrüsten", BackgroundColor3 = C.cyan }, actionRow)
		local mergeButton = button({ Size = UDim2.fromOffset(170, 36), Text = "✨ Verschmelzen", BackgroundColor3 = C.gold }, actionRow)
		local releaseButton = button({ Size = UDim2.fromOffset(200, 36), Text = "🗑️ Freilassen: AUS", BackgroundColor3 = C.grey }, actionRow)
		for _, b in { bestButton, mergeButton, releaseButton } do
			pad(b, 7)
		end
		local grid = scroller(invPage, { Position = UDim2.fromOffset(0, 74), Size = UDim2.new(1, 0, 1, -74) })
		create("UIGridLayout", { CellSize = UDim2.fromOffset(104, 118), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }, grid)

		bestButton.Activated:Connect(function()
			local ok, message = invoke(petAction, "best")
			toast(message, ok and "build" or "error")
		end)
		mergeButton.Activated:Connect(function()
			local ok, message = invoke(petAction, "merge")
			toast(message, ok and "gold" or "error")
		end)
		releaseButton.Activated:Connect(function()
			releaseMode = not releaseMode
			releaseButton.Text = releaseMode and "🗑️ Freilassen: AN" or "🗑️ Freilassen: AUS"
			releaseButton.BackgroundColor3 = releaseMode and C.red or C.grey
		end)

		local function rebuildGrid()
			for _, child in grid:GetChildren() do
				if child:IsA("GuiButton") then
					child:Destroy()
				end
			end
			local list = {}
			for uid, entry in state.pets do
				table.insert(list, { uid = uid, entry = entry, boost = Config.petBoost(entry), equipped = table.find(state.equipped, uid) ~= nil })
			end
			table.sort(list, function(a, b)
				if a.equipped ~= b.equipped then
					return a.equipped
				end
				return a.boost > b.boost
			end)
			for order, item in list do
				local pet, golden = Config.parsePet(item.entry)
				if pet then
					local tile = create("TextButton", {
						LayoutOrder = order,
						Text = "",
						AutoButtonColor = true,
						BackgroundColor3 = item.equipped and Color3.fromRGB(40, 110, 70) or C.card,
					}, grid)
					corner(tile, 12)
					stroke(tile, golden and C.gold or rarityColor(pet), golden and 3 or 2, 0.1)
					text({ Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, 0, 0, 46), Text = pet.icon }, tile)
					local icon, name = petLabel(item.entry)
					local _ = icon
					text({ Position = UDim2.fromOffset(4, 56), Size = UDim2.new(1, -8, 0, 20), Text = name, Font = Enum.Font.GothamBold }, tile)
					text({ Position = UDim2.fromOffset(4, 78), Size = UDim2.new(1, -8, 0, 18), Text = "+" .. format(item.boost * 100) .. " %", TextColor3 = C.gold, Font = Enum.Font.FredokaOne }, tile)
					text({ Position = UDim2.fromOffset(4, 97), Size = UDim2.new(1, -8, 0, 15), Text = item.equipped and "✓ Ausgerüstet" or "", TextColor3 = C.green, Font = Enum.Font.GothamBold }, tile)
					tile.Activated:Connect(function()
						if releaseMode then
							local ok, message = invoke(petAction, "release", item.uid)
							toast(message, ok and "info" or "error")
						else
							local ok, message = invoke(petAction, "equip", item.uid)
							if not ok then
								toast(message, "error")
							end
						end
					end)
				end
			end
			z(grid)
		end

		local function setTab(id)
			tab = id
			eggPage.Visible = id == "eggs"
			invPage.Visible = id == "inventory"
			eggTab.BackgroundColor3 = id == "eggs" and C.purple or C.card
			invTab.BackgroundColor3 = id == "inventory" and C.purple or C.card
		end
		eggTab.Activated:Connect(function()
			setTab("eggs")
		end)
		invTab.Activated:Connect(function()
			setTab("inventory")
		end)
		setTab(tab)
		z(root)
		-- Die Schlüpf-Animation liegt über allem anderen im Fenster
		hatchOverlay.ZIndex = 20
		for _, child in hatchOverlay:GetDescendants() do
			if child:IsA("GuiObject") then
				child.ZIndex = 21
			end
		end

		return function()
			local count = 0
			for _ in state.pets do
				count += 1
			end
			invTab.Text = "🎒 Inventar (" .. count .. "/" .. Config.MAX_PETS .. ")"
			info.Text = "Ausgerüstet " .. #state.equipped .. "/" .. Config.maxEquipped(state) .. "  •  Haustier-Bonus: x" .. string.format("%.2f", Config.petMultiplier(state))
			for _, egg in Config.EGGS do
				eggButtons[egg.id].BackgroundColor3 = state.crystals >= egg.cost and C.green or C.grey
			end
			local parts = {}
			for uid, entry in state.pets do
				table.insert(parts, uid .. "=" .. entry)
			end
			table.sort(parts)
			local signature = table.concat(parts, ",") .. "|" .. table.concat(state.equipped, ",")
			if signature ~= lastSignature then
				lastSignature = signature
				rebuildGrid()
			end
		end
	end,
}

---------------------------------------------------------------------------
-- Glücksrad
---------------------------------------------------------------------------

WINDOWS.wheel = {
	title = "🎡 Glücksrad",
	build = function(root)
		local tiles = {}
		local count = #Config.WHEEL
		local center = create("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(10, 10), BackgroundTransparency = 1 }, root)
		for i, segment in Config.WHEEL do
			local angle = (i - 1) / count * math.pi * 2 - math.pi / 2
			local tile = text({
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(5 + math.cos(angle) * 230, 5 + math.sin(angle) * 150),
				Size = UDim2.fromOffset(120, 54),
				BackgroundTransparency = 0,
				BackgroundColor3 = segment.color,
				Text = segment.label,
				Font = Enum.Font.FredokaOne,
			}, center)
			corner(tile, 12)
			pad(tile, 8)
			tiles[i] = { label = tile, stroke = stroke(tile, Color3.new(1, 1, 1), 0, 0) }
		end
		local spin = button({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(200, 70), BackgroundColor3 = C.gold, TextColor3 = Color3.fromRGB(60, 40, 0) }, root)
		pad(spin, 12)
		local spinning = false

		local function highlight(index)
			for i, tile in tiles do
				tile.stroke.Thickness = (i == index) and 5 or 0
				tile.label.BackgroundTransparency = (i == index) and 0 or 0.45
			end
		end
		highlight(0)

		spin.Activated:Connect(function()
			if spinning or not state then
				return
			end
			spinning = true
			local ok, message, index = invoke(spinWheel)
			if not ok then
				toast(message, "error")
				spinning = false
				return
			end
			local steps = count * 3 + index
			for step = 1, steps do
				highlight((step - 1) % count + 1)
				task.wait(0.04 + (step / steps) ^ 3 * 0.35)
			end
			toast(message, "gold")
			task.wait(1)
			spinning = false
		end)
		z(root)

		return function()
			local left = Config.WHEEL_COOLDOWN - (os.time() - state.lastSpin)
			if spinning then
				spin.Text = "🎡 ..."
			elseif left > 0 then
				spin.Text = "⏳ " .. clock(left)
				spin.BackgroundColor3 = C.grey
			else
				spin.Text = "🎡 DREHEN!"
				spin.BackgroundColor3 = C.gold
			end
		end
	end,
}

---------------------------------------------------------------------------
-- Tägliche Belohnung
---------------------------------------------------------------------------

local function dailyStatus()
	local day = math.floor(os.time() / 86400)
	local canClaim = state.dailyDay ~= day
	local nextStreak = canClaim and ((state.dailyDay == day - 1) and (state.dailyStreak % #Config.DAILY_REWARDS) + 1 or 1) or state.dailyStreak
	return canClaim, nextStreak, day
end

WINDOWS.daily = {
	title = "🎁 Tägliche Belohnung",
	build = function(root)
		text({ Size = UDim2.new(1, 0, 0, 44), Font = Enum.Font.GothamMedium, TextColor3 = C.muted, TextWrapped = true, Text = "Komm jeden Tag wieder! Je länger deine Serie, desto größer die Belohnung. An Tag 7 gibt es zusätzlich Sternenstaub ✨" }, root)
		local row = create("Frame", { Position = UDim2.fromOffset(0, 60), Size = UDim2.new(1, 0, 0, 150), BackgroundTransparency = 1 }, root)
		create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center }, row)
		local cards = {}
		for day, minutes in Config.DAILY_REWARDS do
			local card = create("Frame", { Size = UDim2.fromOffset(76, 150), BackgroundColor3 = C.card }, row)
			corner(card, 12)
			local s = stroke(card, C.gold, 0, 0)
			text({ Position = UDim2.fromOffset(4, 8), Size = UDim2.new(1, -8, 0, 24), Text = "Tag " .. day, Font = Enum.Font.FredokaOne }, card)
			text({ Position = UDim2.fromOffset(4, 40), Size = UDim2.new(1, -8, 0, 40), Text = day == #Config.DAILY_REWARDS and "🎁" or "💎" }, card)
			text({ Position = UDim2.fromOffset(4, 86), Size = UDim2.new(1, -8, 0, 36), Text = minutes .. " Min" .. (day == #Config.DAILY_REWARDS and "\n+1 ✨" or ""), Font = Enum.Font.GothamBold, TextColor3 = C.muted }, card)
			local check = text({ Position = UDim2.fromOffset(4, 124), Size = UDim2.new(1, -8, 0, 20), Text = "", TextColor3 = C.green }, card)
			cards[day] = { card = card, stroke = s, check = check }
		end
		local claim = button({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 236), Size = UDim2.fromOffset(300, 66), BackgroundColor3 = C.gold, TextColor3 = Color3.fromRGB(60, 40, 0) }, root)
		pad(claim, 12)
		claim.Activated:Connect(function()
			local ok, message = invoke(claimDaily)
			toast(message, ok and "gold" or "error")
		end)
		z(root)

		return function()
			local canClaim, nextStreak, day = dailyStatus()
			for i, c in cards do
				local claimed = canClaim and i < nextStreak or (not canClaim and i <= nextStreak)
				c.check.Text = claimed and "✓" or ""
				c.stroke.Thickness = (canClaim and i == nextStreak) and 4 or 0
				c.card.BackgroundColor3 = claimed and Color3.fromRGB(40, 90, 60) or C.card
			end
			if canClaim then
				claim.Text = "🎁 Tag " .. nextStreak .. " abholen!"
				claim.BackgroundColor3 = C.gold
			else
				claim.Text = "🌙 Morgen wieder (" .. clock((day + 1) * 86400 - os.time()) .. ")"
				claim.BackgroundColor3 = C.grey
			end
		end
	end,
}

---------------------------------------------------------------------------
-- Casino: Glücksautomat
---------------------------------------------------------------------------

WINDOWS.casino = {
	title = "🎰 Glücksautomat",
	build = function(root)
		local fraction = Config.SLOT_BETS[1]
		local reels = {}
		local reelRow = create("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.fromOffset(360, 120), BackgroundColor3 = Color3.fromRGB(10, 10, 20) }, root)
		corner(reelRow, 16)
		stroke(reelRow, C.gold, 3, 0)
		create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center }, reelRow)
		for i = 1, 3 do
			local reel = text({ Size = UDim2.fromOffset(100, 100), BackgroundTransparency = 0, BackgroundColor3 = Color3.fromRGB(240, 240, 250), Text = Config.SLOT_SYMBOLS[i] }, reelRow)
			corner(reel, 12)
			pad(reel, 10)
			reels[i] = reel
		end

		local betLabel = text({ Position = UDim2.fromOffset(0, 130), Size = UDim2.new(1, 0, 0, 26), Font = Enum.Font.FredokaOne }, root)
		local betRow = create("Frame", { Position = UDim2.fromOffset(0, 162), Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1 }, root)
		create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center }, betRow)
		local betButtons = {}
		for _, f in Config.SLOT_BETS do
			local b = button({ Size = UDim2.fromOffset(110, 40), BackgroundColor3 = C.card, Text = f >= 1 and "ALLES" or (math.floor(f * 100) .. " %") }, betRow)
			pad(b, 8)
			betButtons[f] = b
			b.Activated:Connect(function()
				fraction = f
			end)
		end

		local spin = button({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 214), Size = UDim2.fromOffset(280, 64), BackgroundColor3 = C.pink, Text = "🎰 DREHEN" }, root)
		pad(spin, 12)
		text({
			Position = UDim2.fromOffset(0, 290),
			Size = UDim2.new(1, 0, 0, 60),
			Font = Enum.Font.GothamMedium,
			TextColor3 = C.muted,
			TextWrapped = true,
			Text = "💎💎💎 x" .. Config.SLOT_TRIPLE["💎"] .. "  •  ⭐⭐⭐ x" .. Config.SLOT_TRIPLE["⭐"] .. "  •  3 gleiche x4  •  2 gleiche x" .. Config.SLOT_PAIR
				.. "\nNur mit Kristallen gespielt – kein echtes Geld. Gewinne zählen nicht für Wiedergeburt.",
		}, root)

		local spinning = false
		spin.Activated:Connect(function()
			if spinning then
				return
			end
			spinning = true
			local result = nil
			task.spawn(function()
				result = table.pack(invoke(playSlots, fraction))
			end)
			local started = os.clock()
			while not result or os.clock() - started < 1 do
				for _, reel in reels do
					reel.Text = Config.SLOT_SYMBOLS[math.random(1, #Config.SLOT_SYMBOLS)]
				end
				task.wait(0.07)
			end
			local ok, message, symbols, net = result[1], result[2], result[3], result[4]
			if ok then
				for i = 1, 3 do
					for _ = 1, 4 + i * 2 do
						for j = i, 3 do
							reels[j].Text = Config.SLOT_SYMBOLS[math.random(1, #Config.SLOT_SYMBOLS)]
						end
						task.wait(0.07)
					end
					reels[i].Text = symbols[i]
				end
				toast(message, net > 0 and "gold" or "error")
			else
				toast(message, "error")
			end
			spinning = false
		end)
		z(root)

		return function()
			for f, b in betButtons do
				b.BackgroundColor3 = (f == fraction) and C.gold or C.card
				b.TextColor3 = (f == fraction) and Color3.fromRGB(60, 40, 0) or Color3.new(1, 1, 1)
			end
			betLabel.Text = "Einsatz: 💎 " .. format(math.floor(state.crystals * fraction))
		end
	end,
}

