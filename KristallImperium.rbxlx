----------------------------------------------------------------------
-- Zahlen schön anzeigen: 1234 -> 1.23K, 5600000 -> 5.60M
----------------------------------------------------------------------

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

function Config.format(n)
	n = tonumber(n) or 0
	if n ~= n then
		return "0"
	end
	local sign = n < 0 and "-" or ""
	n = math.abs(n)
	if n < 1000 then
		if n < 10 and n ~= math.floor(n) then
			return sign .. string.format("%.1f", n)
		end
		return sign .. tostring(math.floor(n))
	end
	local tier = math.floor(math.log10(n) / 3)
	local scaled = n / 10 ^ (tier * 3)
	if scaled >= 999.5 then
		tier += 1
		scaled = n / 10 ^ (tier * 3)
	end
	if tier >= #SUFFIXES then
		return sign .. string.format("%.2e", n)
	end
	local text
	if scaled >= 100 then
		text = string.format("%.0f", scaled)
	elseif scaled >= 10 then
		text = string.format("%.1f", scaled)
	else
		text = string.format("%.2f", scaled)
	end
	return sign .. text .. SUFFIXES[tier + 1]
end

----------------------------------------------------------------------
-- Spielmathematik. `data` hat die Felder:
-- crystals, runTotal, allTime, gens = {[id]=Anzahl}, upgrades = {[id]=true},
-- stardust (je gesammelt), stardustSpent, star = {[id]=Stufe}, rebirths
----------------------------------------------------------------------

function Config.milestonesReached(owned)
	local count = 0
	for _, threshold in Config.MILESTONES do
		if owned >= threshold then
			count += 1
		else
			break
		end
	end
	return count
end

function Config.milestoneMultiplier(owned)
	return 2 ^ Config.milestonesReached(owned)
end

function Config.starLevel(data, id)
	return data.star and data.star[id] or 0
end

function Config.starUpgradeCost(upgrade, level)
	return upgrade.baseCost * 2 ^ level
end

function Config.availableStardust(data)
	return (data.stardust or 0) - (data.stardustSpent or 0)
end

function Config.islandLevel(allTime)
	local level = 0
	for i, entry in Config.ISLAND_LEVELS do
		if (allTime or 0) >= entry.total then
			level = i
		end
	end
	return level
end

function Config.rebirthColor(rebirths)
	return Config.REBIRTH_COLORS[((rebirths or 0) % #Config.REBIRTH_COLORS) + 1]
end

function Config.costMultiplier(data)
	return 1 - 0.06 * Config.starLevel(data, "Discount")
end

function Config.startCrystals(data)
	local level = Config.starLevel(data, "HeadStart")
	return level > 0 and 1000 * 10 ^ (level - 1) or 0
end

function Config.goldenDelayFactor(data)
	local factor = 0.85 ^ Config.starLevel(data, "GoldRush")
	if Config.hasUpgrade(data, "luck") then
		factor *= 0.5
	end
	return factor
end

function Config.nextMilestone(owned)
	for _, threshold in Config.MILESTONES do
		if owned < threshold then
			return threshold
		end
	end
	return nil
end

function Config.generatorCost(gen, owned, amount, data)
	local g = Config.COST_GROWTH
	local mult = data and Config.costMultiplier(data) or 1
	return gen.baseCost * mult * g ^ owned * (g ^ amount - 1) / (g - 1)
end

function Config.maxAffordable(gen, owned, money, data)
	local g = Config.COST_GROWTH
	local first = Config.generatorCost(gen, owned, 1, data)
	if money < first then
		return 0
	end
	local n = math.floor(math.log(money * (g - 1) / first + 1) / math.log(g))
	-- Rundungsfehler abfangen
	while n > 0 and Config.generatorCost(gen, owned, n, data) > money do
		n -= 1
	end
	return n
end

function Config.hasUpgrade(data, kind)
	for id in data.upgrades do
		local upgrade = Config.UPGRADES_BY_ID[id]
		if upgrade and upgrade.kind == kind then
			return true
		end
	end
	return false
end

function Config.stardustMultiplier(data)
	return 1 + Config.STARDUST_BONUS * (data.stardust or 0)
end

function Config.globalMultiplier(data)
	local mult = 1
	for id in data.upgrades do
		local upgrade = Config.UPGRADES_BY_ID[id]
		if upgrade and upgrade.kind == "global" then
			mult *= upgrade.mult
		end
	end
	mult *= 1.5 ^ Config.starLevel(data, "StarEngine")
	return mult * Config.stardustMultiplier(data) * Config.bonusMultiplier(data)
end

-- Produktion eines einzelnen Helfers dieser Sorte (inkl. aller Boni)
function Config.unitRate(data, gen)
	local owned = data.gens[gen.id] or 0
	return gen.baseRate * Config.milestoneMultiplier(owned) * Config.globalMultiplier(data)
end

-- Kristalle pro Sekunde (ohne Kristallrausch)
function Config.production(data)
	local total = 0
	for _, gen in Config.GENERATORS do
		local owned = data.gens[gen.id] or 0
		if owned > 0 then
			total += gen.baseRate * owned * Config.milestoneMultiplier(owned)
		end
	end
	return total * Config.globalMultiplier(data)
end

-- Kristalle pro Klick (ohne Kristallrausch)
function Config.clickValue(data)
	local mult, percent = 1, 0
	for id in data.upgrades do
		local upgrade = Config.UPGRADES_BY_ID[id]
		if upgrade and upgrade.kind == "click" then
			mult *= upgrade.mult
		elseif upgrade and upgrade.kind == "clickPercent" then
			percent += upgrade.value
		end
	end
	mult *= 2 ^ Config.starLevel(data, "StarClick")
	return mult * Config.stardustMultiplier(data) * Config.bonusMultiplier(data) + Config.production(data) * percent
end

-- Automatische Klicks der Kristall-Drohne pro Sekunde
function Config.droneClicks(data)
	return 2 * Config.starLevel(data, "Drone")
end

-- Gesamte Kristalle pro Sekunde (Helfer + Drohne, ohne Kristallrausch)
function Config.perSecond(data)
	return Config.production(data) + Config.droneClicks(data) * Config.clickValue(data)
end

-- Haustiere: Eintrag "Cat" = normal, "Cat*" = golden
function Config.parsePet(entry)
	if type(entry) ~= "string" then
		return nil, false
	end
	local golden = string.sub(entry, -1) == "*"
	local id = golden and string.sub(entry, 1, -2) or entry
	return Config.PETS_BY_ID[id], golden
end

function Config.petBoost(entry)
	local pet, golden = Config.parsePet(entry)
	if not pet then
		return 0
	end
	return pet.boost * (golden and Config.GOLDEN_PET_FACTOR or 1)
end

function Config.maxEquipped(data)
	return Config.MAX_EQUIPPED + ((data.passes and data.passes.PetSlots) and 2 or 0)
end

function Config.petMultiplier(data)
	local total = 1
	if data.pets and data.equipped then
		for _, uid in data.equipped do
			total += Config.petBoost(data.pets[uid])
		end
	end
	return total
end

-- Haustiere und VIP-Pass
function Config.bonusMultiplier(data)
	local vip = (data.passes and data.passes.VIP) and 2 or 1
	return Config.petMultiplier(data) * vip
end

-- Zeitlich begrenzte Boosts (Kristallrausch, Like-Boost). `boosts` hat frenzyEnd und likeEnd.
function Config.tempMultiplier(boosts, serverTime)
	local mult = 1
	if (boosts.frenzyEnd or 0) > serverTime then
		mult *= Config.FRENZY_MULTIPLIER
	end
	if (boosts.likeEnd or 0) > serverTime then
		mult *= Config.LIKE_BOOST
	end
	return mult
end

function Config.skinUnlocked(data, skin)
	local unlock = skin.unlock
	if unlock.kind == "free" or (data.skins and data.skins[skin.id]) then
		return true
	elseif unlock.kind == "likes" then
		return (data.likes or 0) >= unlock.amount
	elseif unlock.kind == "golem" then
		return (data.golemKills or 0) >= unlock.amount
	elseif unlock.kind == "rebirths" then
		return (data.rebirths or 0) >= unlock.amount
	end
	return false
end

function Config.skinRequirement(skin)
	local unlock = skin.unlock
	if unlock.kind == "crystals" then
		return "💎 " .. Config.format(unlock.cost)
	elseif unlock.kind == "likes" then
		return "❤️ " .. unlock.amount .. " Likes erhalten"
	elseif unlock.kind == "golem" then
		return "⚔️ " .. unlock.amount .. " Golems besiegen"
	elseif unlock.kind == "rebirths" then
		return "🌟 " .. unlock.amount .. " Wiedergeburten"
	elseif unlock.kind == "robux" then
		return "🛍️ Robux-Shop"
	end
	return ""
end

function Config.stardustForRun(runTotal)
	return math.floor(math.sqrt((runTotal or 0) / Config.REBIRTH_BASE))
end

-- Wie viele Kristalle braucht man in diesem Durchlauf für `stardust` Sternenstaub?
function Config.runTotalForStardust(stardust)
	return stardust * stardust * Config.REBIRTH_BASE
end

return Config
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000000000000000000000000000003"><Properties><string name="Name">Modelle</string></Properties></Item></Item><Item class="ServerScriptService" referent="RBX0000000000000000000000000000000C"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX0000000000000000000000000000000B"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX00000000000000000000000000000005"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Kristall-Imperium: Hauptskript (Server).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local MapBuilder = require(script.Parent.MapBuilder)
local PlayerData = require(script.Parent.PlayerData)
local Hub = require(script.Parent.Hub)
local Pets = require(script.Parent.Pets)
local Fun = require(script.Parent.Fun)

-- Remotes ---------------------------------------------------------------

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local function remote(className, name)
	local r = Instance.new(className)
	r.Name = name
	r.Parent = remotes
	return r
end
local mineEvent = remote("RemoteEvent", "Mine")
local stateEvent = remote("RemoteEvent", "State")
local notifyEvent = remote("RemoteEvent", "Notify")
local buyFunction = remote("RemoteFunction", "Buy")
local rebirthFunction = remote("RemoteFunction", "Rebirth")
remotes.Parent = ReplicatedStorage

MapBuilder.build()
Players.CharacterAutoLoads = false

-- Sitzungen -------------------------------------------------------------

-- sessions[player] = { data, plot, tokens, frenzyEnd, nextGolden, golden, lastLevel }
local sessions = {}

local function now()
	return workspace:GetServerTimeNow()
end

-- Kristallrausch und Like-Boost
local function frenzyMultiplier(session)
	return Config.tempMultiplier(session, now())
end

local function notify(player, text, kind)
	notifyEvent:FireClient(player, text, kind)
end

local function sendState(player)
	local session = sessions[player]
	if not session then
		return
	end
	local data = session.data
	stateEvent:FireClient(player, {
		crystals = data.crystals,
		runTotal = data.runTotal,
		allTime = data.allTime,
		gens = data.gens,
		upgrades = data.upgrades,
		star = data.star,
		stardust = data.stardust,
		stardustSpent = data.stardustSpent,
		rebirths = data.rebirths,
		frenzyEnd = session.frenzyEnd,
		likeEnd = session.likeEnd,
		pets = data.pets,
		equipped = data.equipped,
		skins = data.skins,
		skin = data.skin,
		likes = data.likes,
		golemKills = data.golemKills,
		dailyDay = data.dailyDay,
		dailyStreak = data.dailyStreak,
		lastSpin = data.lastSpin,
		passes = data.passes,
	})
end

local function scheduleGolden(session)
	local delay = Config.GOLDEN_MIN_DELAY + math.random() * (Config.GOLDEN_MAX_DELAY - Config.GOLDEN_MIN_DELAY)
	session.nextGolden = os.clock() + delay * Config.goldenDelayFactor(session.data)
end

local function earn(session, amount)
	local data = session.data
	data.crystals += amount
	data.runTotal += amount
	data.allTime += amount
end

-- Prüft, ob die Insel eine neue Ausbaustufe erreicht hat
local function checkIslandLevel(player, session)
	local level = Config.islandLevel(session.data.allTime)
	if level > session.lastLevel then
		session.lastLevel = level
		MapBuilder.updatePlot(session.plot, session.data)
		notify(player, "🏗️ Deine Insel wächst: " .. Config.ISLAND_LEVELS[level].name .. "!", "build")
	end
end

-- Spieler betreten / verlassen ------------------------------------------

local function onCharacterAdded(player, character)
	local session = sessions[player]
	if not session then
		return
	end
	local humanoid = character:WaitForChild("Humanoid")
	character:WaitForChild("HumanoidRootPart")
	humanoid.Died:Connect(function()
		task.delay(2, function()
			if player.Parent == Players and player.Character == character then
				player:LoadCharacter()
			end
		end)
	end)
	task.wait()
	if character.Parent then
		character:PivotTo(session.plot.spawnCF)
	end
end

local function onPlayerAdded(player)
	local plot = MapBuilder.claimPlot(player)
	if not plot then
		player:Kick("Dieser Server ist voll. Bitte versuch es auf einem anderen Server.")
		return
	end

	local data = PlayerData.load(player)
	if player.Parent ~= Players then
		MapBuilder.releasePlot(plot)
		PlayerData.release(player)
		return
	end

	local session = {
		data = data,
		plot = plot,
		tokens = Config.CLICKS_PER_SECOND,
		frenzyEnd = 0,
		likeEnd = 0,
		nextGolden = 0,
		golden = nil,
		lastLevel = Config.islandLevel(data.allTime),
	}
	sessions[player] = session
	scheduleGolden(session)
	MapBuilder.updatePlot(plot, data)
	Pets.onJoin(player, session)

	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	player:LoadCharacter()

	-- Offline-Einnahmen
	local offlineSeconds = data.lastSeen > 0 and math.clamp(os.time() - data.lastSeen, 0, Config.OFFLINE_MAX_SECONDS) or 0
	local factor = Config.hasUpgrade(data, "offline") and 1 or Config.OFFLINE_FACTOR
	local offlineGain = Config.perSecond(data) * offlineSeconds * factor
	sendState(player)
	task.delay(3, function()
		if sessions[player] ~= session then
			return
		end
		if offlineGain >= 1 then
			earn(session, offlineGain)
			notify(player, "😴 Während du weg warst, haben deine Helfer " .. Config.format(offlineGain) .. " 💎 gesammelt!", "gold")
			checkIslandLevel(player, session)
		else
			notify(player, "Willkommen bei " .. Config.GAME_NAME .. "! Klick den Kristall 💎", "info")
		end
	end)
end

local function onPlayerRemoving(player)
	local session = sessions[player]
	sessions[player] = nil
	if session then
		if session.golden then
			session.golden:Destroy()
		end
		MapBuilder.releasePlot(session.plot)
	end
	PlayerData.release(player)
end

-- Zusatz-Module (Hub-Insel, Haustiere, Robux, Glücksrad, Casino, Skins) ----

local ctx = {
	sessions = sessions,
	now = now,
	earn = earn,
	notify = notify,
	notifyAll = function(text, kind)
		notifyEvent:FireAllClients(text, kind)
	end,
	sendState = sendState,
	remote = remote,
	PlayerData = PlayerData,
	MapBuilder = MapBuilder,
	boost = frenzyMultiplier,
}
Hub.init(ctx)
Pets.init(ctx)
Fun.init(ctx)

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end
PlayerData.startAutosave()

-- Klicken ---------------------------------------------------------------

mineEvent.OnServerEvent:Connect(function(player)
	local session = sessions[player]
	if not session or session.tokens < 1 then
		return
	end
	session.tokens -= 1
	earn(session, Config.clickValue(session.data) * frenzyMultiplier(session))
end)

-- Goldene Kristalle -----------------------------------------------------

local function collectGolden(player, session)
	local golden = session.golden
	if not golden then
		return
	end
	session.golden = nil
	golden:Destroy()

	local data = session.data
	local rewardMult = Config.hasUpgrade(data, "goldenReward") and 3 or 1
	if math.random() < 0.55 then
		local amount = math.max(Config.perSecond(data) * 90, Config.clickValue(data) * 40, 50) * rewardMult
		earn(session, amount)
		notify(player, "🍀 Glücksfund! +" .. Config.format(amount) .. " 💎", "gold")
	else
		local duration = Config.FRENZY_DURATION * rewardMult
		session.frenzyEnd = now() + duration
		notify(player, "🔥 KRISTALLRAUSCH! Alles x" .. Config.FRENZY_MULTIPLIER .. " für " .. duration .. " Sekunden!", "frenzy")
	end
	sendState(player)
end

local function spawnGolden(player, session)
	local golden, click, core = MapBuilder.spawnGolden(session.plot)
	session.golden = golden
	click.MouseClick:Connect(function(clicker)
		if clicker == player and sessions[player] == session and session.golden == golden then
			collectGolden(player, session)
		end
	end)
	core.Touched:Connect(function(hit)
		local character = player.Character
		if character and hit:IsDescendantOf(character) and session.golden == golden then
			collectGolden(player, session)
		end
	end)
	notify(player, "✨ Ein goldener Kristall ist auf deiner Insel erschienen!", "gold")
	task.delay(Config.GOLDEN_LIFETIME, function()
		if session.golden == golden then
			session.golden = nil
			golden:Destroy()
		end
	end)
end

-- Spielschleife ---------------------------------------------------------

local sendTimer, slowTimer = 0, 0

RunService.Heartbeat:Connect(function(dt)
	sendTimer += dt
	slowTimer += dt
	local sendNow = sendTimer >= 0.25
	local slowNow = slowTimer >= 1
	if sendNow then
		sendTimer = 0
	end
	if slowNow then
		slowTimer = 0
	end

	for player, session in sessions do
		-- Sicherheitsnetz: Wer von der Insel fällt, kommt zurück zum Startpunkt
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root.Position.Y < -40 then
			root.AssemblyLinearVelocity = Vector3.zero
			character:PivotTo(session.plot.spawnCF)
		end

		session.tokens = math.min(Config.CLICKS_PER_SECOND, session.tokens + Config.CLICKS_PER_SECOND * dt)
		earn(session, Config.perSecond(session.data) * frenzyMultiplier(session) * dt)

		if not session.golden and os.clock() >= session.nextGolden then
			scheduleGolden(session)
			spawnGolden(player, session)
		end
		if sendNow then
			sendState(player)
		end
		if slowNow then
			checkIslandLevel(player, session)
			PlayerData.updateLeaderstats(player)
			session.plot.sign.Text = "🏝️ " .. player.DisplayName .. "\n💎 " .. Config.format(Config.perSecond(session.data)) .. "/Sek  •  ❤️ " .. session.data.likes
		end
	end
end)

-- Shop ------------------------------------------------------------------

local function buyGenerator(player, session, id, amount)
	local gen = Config.GENERATORS_BY_ID[id]
	if not gen then
		return false, "Unbekannter Helfer."
	end
	local data = session.data
	local owned = data.gens[id] or 0
	local count
	if amount == "max" then
		count = Config.maxAffordable(gen, owned, data.crystals, data)
	elseif amount == 1 or amount == 10 or amount == 100 then
		count = amount
	else
		return false, "Ungültige Menge."
	end
	if count < 1 then
		return false, "Nicht genug Kristalle."
	end
	local cost = Config.generatorCost(gen, owned, count, data)
	if cost > data.crystals then
		return false, "Nicht genug Kristalle."
	end

	data.crystals -= cost
	data.gens[id] = owned + count
	MapBuilder.updatePlot(session.plot, data)

	local before, after = Config.milestonesReached(owned), Config.milestonesReached(owned + count)
	if after > before then
		notify(player, "🎉 Meilenstein! " .. gen.name .. " produziert jetzt x" .. Config.milestoneMultiplier(owned + count) .. "!", "build")
	end
	return true, gen.icon .. " +" .. count .. " " .. gen.name
end

local function buyUpgrade(session, id)
	local upgrade = Config.UPGRADES_BY_ID[id]
	local data = session.data
	if not upgrade then
		return false, "Unbekanntes Upgrade."
	end
	if data.upgrades[id] then
		return false, "Schon gekauft."
	end
	if data.crystals < upgrade.cost then
		return false, "Nicht genug Kristalle."
	end
	data.crystals -= upgrade.cost
	data.upgrades[id] = true
	if upgrade.kind == "luck" then
		scheduleGolden(session)
	end
	return true, upgrade.icon .. " " .. upgrade.name .. " gekauft!"
end

local function buyStarUpgrade(session, id)
	local upgrade = Config.STAR_UPGRADES_BY_ID[id]
	local data = session.data
	if not upgrade then
		return false, "Unbekanntes Upgrade."
	end
	local level = Config.starLevel(data, id)
	if level >= upgrade.maxLevel then
		return false, "Schon auf der höchsten Stufe."
	end
	local cost = Config.starUpgradeCost(upgrade, level)
	if Config.availableStardust(data) < cost then
		return false, "Nicht genug Sternenstaub."
	end
	data.stardustSpent += cost
	data.star[id] = level + 1
	return true, upgrade.icon .. " " .. upgrade.name .. " ist jetzt Stufe " .. (level + 1) .. "!"
end

buyFunction.OnServerInvoke = function(player, kind, id, amount)
	local session = sessions[player]
	if not session or type(id) ~= "string" then
		return false, "Fehler."
	end
	local ok, message
	if kind == "gen" then
		ok, message = buyGenerator(player, session, id, amount)
	elseif kind == "upgrade" then
		ok, message = buyUpgrade(session, id)
	elseif kind == "star" then
		ok, message = buyStarUpgrade(session, id)
	else
		return false, "Fehler."
	end
	sendState(player)
	return ok, message
end

-- Wiedergeburt ----------------------------------------------------------

rebirthFunction.OnServerInvoke = function(player)
	local session = sessions[player]
	if not session then
		return false, "Fehler."
	end
	local data = session.data
	local gain = Config.stardustForRun(data.runTotal)
	if gain < 1 then
		return false, "Sammle erst " .. Config.format(Config.REBIRTH_BASE) .. " 💎 in dieser Runde."
	end

	data.stardust += gain
	data.rebirths += 1
	data.runTotal = 0
	data.gens = {}
	data.upgrades = {}
	data.crystals = Config.startCrystals(data)
	session.frenzyEnd = 0

	MapBuilder.updatePlot(session.plot, data)
	PlayerData.updateLeaderstats(player)
	sendState(player)
	task.spawn(PlayerData.save, player)
	notifyEvent:FireAllClients("🌟 " .. player.DisplayName .. " ist wiedergeboren! (Rebirth " .. data.rebirths .. ")", "frenzy")
	return true, "✨ +" .. gain .. " Sternenstaub! Dein Kristall leuchtet in neuer Farbe."
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000006"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[-- Baut die Welt: schwebende Inseln mit Riesenkristall und Sockeln für die Helfer.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local MapBuilder = {}
MapBuilder.plots = {}
MapBuilder.ISLAND_SIZE = 96

local CRYSTAL_COLOR = Color3.fromRGB(90, 200, 255)
local GOLD = Color3.fromRGB(255, 205, 60)
local STONE = Color3.fromRGB(120, 120, 135)
local DARK_STONE = Color3.fromRGB(70, 70, 85)
local GRASS = Color3.fromRGB(100, 190, 90)
local ROCK = Color3.fromRGB(120, 95, 75)
local WOOD = Color3.fromRGB(120, 80, 50)

local SLOT_RADIUS = 22
local ISLAND_SIZE = 96

----------------------------------------------------------------------
-- Helfer
----------------------------------------------------------------------

local function makePart(parent, props, className)
	local p = Instance.new(className or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		p[key] = value
	end
	p.Parent = parent
	return p
end

-- Zylinder mit senkrechter Achse (Roblox-Zylinder liegen sonst auf der X-Achse)
local function vCylinder(parent, height, diameter, cframe, color, material)
	return makePart(parent, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, diameter, diameter),
		CFrame = cframe * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
	})
end

local function ball(parent, diameter, cframe, color, material)
	return makePart(parent, {
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(diameter, diameter, diameter),
		CFrame = cframe,
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
	})
end

local function billboard(parent, widthStuds, heightStuds, offsetY, maxDistance)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(widthStuds, 0, heightStuds, 0) -- in Studs: wird mit Entfernung kleiner
	gui.StudsOffset = Vector3.new(0, offsetY, 0)
	gui.MaxDistance = maxDistance or 120
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.2
	label.Parent = gui
	gui.Parent = parent
	return label
end

-- Facettierter Kristall: Prisma mit Spitze oben und unten (Würfel auf der Ecke).
-- Gibt das mittlere Teil zurück.
local TIP_ROTATION = CFrame.Angles(0, 0, math.rad(35.264)) * CFrame.Angles(math.rad(-45), 0, 0)

local function crystalShape(parent, cf, width, height, color, material, transparency)
	local props = { Color = color, Material = material or Enum.Material.Neon, Transparency = transparency or 0 }
	local function withProps(extra)
		for key, value in props do
			extra[key] = value
		end
		return extra
	end
	local core = makePart(parent, withProps({
		Name = "Core",
		Size = Vector3.new(width, height, width),
		CFrame = cf * CFrame.Angles(0, math.rad(45), 0),
	}))
	local tip = width * 0.74
	for _, direction in { 1, -1 } do
		makePart(parent, withProps({
			Name = "Tip",
			Size = Vector3.new(tip, tip, tip),
			CFrame = cf * CFrame.new(0, direction * height / 2, 0) * TIP_ROTATION,
		}))
	end
	return core
end

----------------------------------------------------------------------
-- Natürliches Gelände (Roblox-Terrain) statt eckiger Teile
----------------------------------------------------------------------

local Terrain = workspace.Terrain

-- Schwebende Insel: flache Grasdecke mit unregelmäßigem Rand, felsige Unterseite
local function terrainIsland(center, radius, rng)
	Terrain:FillCylinder(CFrame.new(center + Vector3.new(0, -3, 0)), 6, radius, Enum.Material.Grass)
	-- unregelmäßiger Rand
	for _ = 1, 16 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = radius * rng:NextNumber(0.9, 1.02)
		Terrain:FillBall(center + Vector3.new(math.cos(a) * r, -5, math.sin(a) * r), rng:NextNumber(4, 6), Enum.Material.Grass)
	end
	-- Unterseite: nach unten schmaler werdende Erd- und Felsschichten
	for i = 1, 5 do
		local layerRadius = radius * (1 - i * 0.16)
		local material = (i == 1) and Enum.Material.Ground or Enum.Material.Rock
		Terrain:FillCylinder(CFrame.new(center + Vector3.new(0, -3 - i * 6, 0)), 6, layerRadius, material)
	end
	-- Felsbrocken für eine natürliche, zerklüftete Form
	for _ = 1, 22 do
		local a = rng:NextNumber(0, math.pi * 2)
		local spread = rng:NextNumber(0.15, 0.85)
		local ballRadius = rng:NextNumber(5, 10)
		local depth = 6 + (1 - spread) * rng:NextNumber(8, 26)
		local material = rng:NextNumber() < 0.7 and Enum.Material.Rock or Enum.Material.Slate
		Terrain:FillBall(center + Vector3.new(math.cos(a) * radius * spread, -depth - ballRadius * 0.4, math.sin(a) * radius * spread), ballRadius, material)
	end
	Terrain:FillBall(center + Vector3.new(0, -38, 0), 7, Enum.Material.Rock)
end

----------------------------------------------------------------------
-- Eigene 3D-Modelle: Lege Modelle in ReplicatedStorage > Modelle
-- (Name = ID, z. B. "Pickaxe", "Golem"). Sonst werden einfache Modelle gebaut.
----------------------------------------------------------------------

-- Macht aus einem Toolbox-Fund ein Modell (auch wenn es nur ein einzelnes MeshPart ist)
local function cloneAsModel(template)
	if template:IsA("Model") then
		return template:Clone()
	elseif template:IsA("BasePart") then
		local model = Instance.new("Model")
		model.Name = template.Name
		template:Clone().Parent = model
		return model
	end
	return nil
end

local function customModel(name, targetSize, cframe, template)
	local folder = ReplicatedStorage:FindFirstChild("Modelle")
	template = template or (folder and folder:FindFirstChild(name))
	local model = template and cloneAsModel(template)
	if not model then
		return nil
	end
	for _, inst in model:GetDescendants() do
		if inst:IsA("LuaSourceContainer") then
			inst:Destroy() -- Skripte aus Toolbox-Modellen nie mitlaufen lassen
		elseif inst:IsA("BasePart") then
			inst.Anchored = true
			inst.CanCollide = false
		end
	end
	local boxCF, size = model:GetBoundingBox()
	local biggest = math.max(size.X, size.Y, size.Z)
	if biggest > 0 then
		model.WorldPivot = boxCF
		model:ScaleTo(model:GetScale() * targetSize / biggest)
	end
	local _, newSize = model:GetBoundingBox()
	model:PivotTo(cframe * CFrame.new(0, newSize.Y / 2, 0))
	return model
end

-- Cartoon-Baum: Stamm mit runden, weichen Kronen (oder eine Tanne)
local function softBall(parent, size, cframe, color)
	local p = makePart(parent, { Size = size, CFrame = cframe, Color = color, CanCollide = false })
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

local function terrainTree(parent, pos, rng)
	-- Eigene Bäume: alle Modelle in "Modelle", deren Name mit "Baum" beginnt
	local folder = ReplicatedStorage:FindFirstChild("Modelle")
	if folder then
		local trees = {}
		for _, child in folder:GetChildren() do
			if string.sub(child.Name, 1, 4) == "Baum" then
				table.insert(trees, child)
			end
		end
		if #trees > 0 then
			local template = trees[rng:NextInteger(1, #trees)]
			local size = rng:NextNumber(11, 15)
			local tree = customModel(template.Name, size, CFrame.new(pos) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0), template)
			if tree then
				tree.Parent = parent
				return
			end
		end
	end
	local leaf = Color3.fromHSV(rng:NextNumber(0.24, 0.36), rng:NextNumber(0.55, 0.7), rng:NextNumber(0.6, 0.8))
	local leafLight = leaf:Lerp(Color3.fromRGB(230, 255, 180), 0.25)
	local pine = rng:NextNumber() < 0.3
	local height = rng:NextNumber(5, 7)
	makePart(parent, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, 1.3, 1.3),
		CFrame = CFrame.new(pos + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = WOOD,
		Material = Enum.Material.Wood,
	})
	local top = pos + Vector3.new(0, height, 0)
	if pine then
		local dark = leaf:Lerp(Color3.fromRGB(20, 60, 40), 0.35)
		for i, size in { 7, 5.2, 3.4 } do
			softBall(parent, Vector3.new(size, 3.2, size), CFrame.new(top + Vector3.new(0, (i - 1) * 2.2, 0)), dark)
		end
	else
		softBall(parent, Vector3.new(7, 6, 7), CFrame.new(top + Vector3.new(0, 1.5, 0)), leaf)
		for k = 1, 3 do
			local a = k / 3 * math.pi * 2 + rng:NextNumber(0, 1)
			softBall(parent, Vector3.new(4.2, 3.8, 4.2), CFrame.new(top + Vector3.new(math.cos(a) * 2.6, rng:NextNumber(0.2, 2.2), math.sin(a) * 2.6)), k == 1 and leafLight or leaf)
		end
	end
end

----------------------------------------------------------------------
-- Die 3D-Modelle der Helfer. `cf` = Oberseite des Sockels, Blick zur Inselmitte.
----------------------------------------------------------------------

local MODEL_BUILDERS = {}

MODEL_BUILDERS.Pickaxe = function(m, cf)
	local handleCF = cf * CFrame.new(0, 2.6, 0) * CFrame.Angles(0, 0, math.rad(70))
	makePart(m, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(5, 0.5, 0.5),
		CFrame = handleCF,
		Color = WOOD,
		Material = Enum.Material.Wood,
	})
	makePart(m, {
		Size = Vector3.new(0.7, 0.7, 3.8),
		CFrame = handleCF * CFrame.new(2.3, 0, 0),
		Color = Color3.fromRGB(190, 195, 205),
		Material = Enum.Material.Metal,
	})
	ball(m, 1, cf * CFrame.new(1.4, 0.5, 0.8), CRYSTAL_COLOR, Enum.Material.Neon)
end

MODEL_BUILDERS.Dwarf = function(m, cf)
	vCylinder(m, 2.4, 2.4, cf * CFrame.new(0, 1.2, 0), Color3.fromRGB(70, 110, 200))
	makePart(m, { Size = Vector3.new(2.5, 0.4, 2.5), CFrame = cf * CFrame.new(0, 1.6, 0), Color = Color3.fromRGB(90, 60, 40) })
	ball(m, 1.9, cf * CFrame.new(0, 3.2, 0), Color3.fromRGB(240, 195, 160))
	makePart(m, { Size = Vector3.new(1.4, 1.4, 0.5), CFrame = cf * CFrame.new(0, 2.6, -0.75), Color = Color3.fromRGB(240, 240, 240) })
	ball(m, 0.55, cf * CFrame.new(0, 3.25, -0.95), Color3.fromRGB(230, 150, 130))
	vCylinder(m, 0.3, 2.3, cf * CFrame.new(0, 3.95, 0), Color3.fromRGB(200, 40, 50))
	makePart(m, {
		Size = Vector3.new(1.2, 1.2, 1.2),
		CFrame = cf * CFrame.new(0, 4.5, 0) * CFrame.Angles(math.rad(45), 0, math.rad(45)),
		Color = Color3.fromRGB(200, 40, 50),
	})
end

MODEL_BUILDERS.Drill = function(m, cf)
	local copper = Color3.fromRGB(200, 120, 70)
	vCylinder(m, 2, 3.6, cf * CFrame.new(0, 1, 0), DARK_STONE, Enum.Material.Metal)
	vCylinder(m, 1.8, 2.8, cf * CFrame.new(0, 2.9, 0), copper, Enum.Material.Metal)
	vCylinder(m, 1.6, 1.8, cf * CFrame.new(0, 4.6, 0), copper, Enum.Material.Metal)
	vCylinder(m, 1, 0.8, cf * CFrame.new(0, 5.9, 0), Color3.fromRGB(220, 220, 230), Enum.Material.Metal)
	vCylinder(m, 3, 0.8, cf * CFrame.new(1.9, 3, 0), DARK_STONE, Enum.Material.Metal)
	ball(m, 0.9, cf * CFrame.new(1.9, 4.6, 0), Color3.fromRGB(255, 140, 60), Enum.Material.Neon)
end

MODEL_BUILDERS.Mine = function(m, cf)
	for _, x in { -1.9, 1.9 } do
		makePart(m, { Size = Vector3.new(1.4, 4, 1.6), CFrame = cf * CFrame.new(x, 2, 0), Color = ROCK, Material = Enum.Material.Slate })
	end
	makePart(m, { Size = Vector3.new(5.4, 1, 2), CFrame = cf * CFrame.new(0, 4.5, 0), Color = WOOD, Material = Enum.Material.Wood })
	makePart(m, { Size = Vector3.new(2.4, 3.6, 0.4), CFrame = cf * CFrame.new(0, 1.8, 0.4), Color = Color3.fromRGB(20, 20, 25) })
	makePart(m, { Size = Vector3.new(1.8, 1, 1.3), CFrame = cf * CFrame.new(0, 0.5, -1.8), Color = STONE, Material = Enum.Material.Metal })
	for i = -1, 1 do
		ball(m, 0.7, cf * CFrame.new(i * 0.5, 1.15, -1.8), CRYSTAL_COLOR, Enum.Material.Neon)
	end
end

MODEL_BUILDERS.Laser = function(m, cf)
	makePart(m, { Size = Vector3.new(2.8, 1, 2.8), CFrame = cf * CFrame.new(0, 0.5, 0), Color = DARK_STONE, Material = Enum.Material.Metal })
	vCylinder(m, 6, 1.2, cf * CFrame.new(0, 4, 0), Color3.fromRGB(200, 200, 215), Enum.Material.Metal)
	vCylinder(m, 0.3, 2.8, cf * CFrame.new(0, 5.6, 0), DARK_STONE, Enum.Material.Metal)
	local orb = ball(m, 1.7, cf * CFrame.new(0, 7.4, 0), Color3.fromRGB(255, 60, 80), Enum.Material.Neon)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 60, 80)
	light.Range = 10
	light.Parent = orb
end

MODEL_BUILDERS.Portal = function(m, cf)
	local violet = Color3.fromRGB(170, 90, 255)
	makePart(m, { Size = Vector3.new(4, 1, 2), CFrame = cf * CFrame.new(0, 0.5, 0), Color = DARK_STONE, Material = Enum.Material.Slate })
	local center = cf * CFrame.new(0, 3.8, 0)
	for k = 0, 11 do
		local angle = k / 12 * math.pi * 2
		makePart(m, {
			Size = Vector3.new(1, 1, 1),
			CFrame = center * CFrame.new(math.cos(angle) * 2.7, math.sin(angle) * 2.7, 0) * CFrame.Angles(0, 0, angle),
			Color = violet,
			Material = Enum.Material.Neon,
		})
	end
	makePart(m, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 4.8, 4.8),
		CFrame = center * CFrame.Angles(0, math.rad(90), 0),
		Color = Color3.fromRGB(120, 60, 220),
		Material = Enum.Material.Neon,
		Transparency = 0.45,
	})
end

MODEL_BUILDERS.Forge = function(m, cf)
	local iron = Color3.fromRGB(60, 60, 70)
	makePart(m, { Size = Vector3.new(2.2, 1.2, 1.6), CFrame = cf * CFrame.new(0, 0.6, 0), Color = iron, Material = Enum.Material.Metal })
	makePart(m, { Size = Vector3.new(1.1, 1, 1), CFrame = cf * CFrame.new(0, 1.7, 0), Color = iron, Material = Enum.Material.Metal })
	makePart(m, { Size = Vector3.new(3.4, 0.8, 1.5), CFrame = cf * CFrame.new(0, 2.6, 0), Color = iron, Material = Enum.Material.Metal })
	makePart(m, { Size = Vector3.new(1.3, 0.3, 0.7), CFrame = cf * CFrame.new(0, 3.15, 0), Color = Color3.fromRGB(255, 130, 40), Material = Enum.Material.Neon })
	local star = ball(m, 1.2, cf * CFrame.new(0, 5, 0), Color3.fromRGB(255, 230, 90), Enum.Material.Neon)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 200, 80)
	light.Range = 12
	light.Parent = star
end

MODEL_BUILDERS.Core = function(m, cf)
	local center = cf * CFrame.new(0, 4, 0)
	makePart(m, { Size = Vector3.new(2, 1, 2), CFrame = cf * CFrame.new(0, 0.5, 0), Color = DARK_STONE, Material = Enum.Material.Metal })
	local glass = ball(m, 4.2, center, Color3.fromRGB(40, 50, 120), Enum.Material.Glass)
	glass.Transparency = 0.45
	ball(m, 2.2, center, Color3.fromRGB(255, 110, 220), Enum.Material.Neon)
	for _, tilt in { 20, -35 } do
		makePart(m, {
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.15, 6.4, 6.4),
			CFrame = center * CFrame.Angles(math.rad(tilt), 0, math.rad(90)),
			Color = Color3.fromRGB(110, 220, 255),
			Material = Enum.Material.Neon,
			Transparency = 0.5,
		})
	end
end

local function buildGeneratorModel(slot, gen)
	local custom = customModel(gen.id, 6, slot.top)
	if custom then
		custom.Name = gen.id
		custom.WorldPivot = slot.top
		custom.Parent = slot.folder
		CollectionService:AddTag(custom, "GenModel")
		return custom
	end
	local model = Instance.new("Model")
	model.Name = gen.id
	MODEL_BUILDERS[gen.id](model, slot.top)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.CastShadow = true
		end
	end
	model.WorldPivot = slot.top
	model.Parent = slot.folder
	CollectionService:AddTag(model, "GenModel")
	return model
end

----------------------------------------------------------------------
-- Ausbaustufen der Insel (Config.ISLAND_LEVELS). Jede Funktion baut eine Stufe.
----------------------------------------------------------------------

local function spinModel(parent, name)
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	return model
end

local DECOR_BUILDERS = {
	-- 1 Steinweg: Ring aus Kopfsteinpflaster um den Kristall
	function(_, plot)
		Terrain:FillCylinder(CFrame.new(plot.center + Vector3.new(0, -1, 0)), 2, 16.5, Enum.Material.Cobblestone)
		Terrain:FillCylinder(CFrame.new(plot.center + Vector3.new(0, -1, 0)), 2, 11.5, Enum.Material.Grass)
	end,

	-- 2 Laternen zwischen den Sockeln
	function(folder, plot)
		for k = 0, 7 do
			local a = (k + 0.5) / 8 * math.pi * 2
			local pos = plot.center + Vector3.new(math.cos(a) * 30, 0, math.sin(a) * 30)
			vCylinder(folder, 6, 0.6, CFrame.new(pos + Vector3.new(0, 3, 0)), Color3.fromRGB(40, 40, 50), Enum.Material.Metal)
			local lamp = ball(folder, 1.4, CFrame.new(pos + Vector3.new(0, 6.6, 0)), Color3.fromRGB(255, 220, 140), Enum.Material.Neon)
			local light = Instance.new("PointLight")
			light.Color = Color3.fromRGB(255, 210, 130)
			light.Range = 14
			light.Brightness = 1.5
			light.Parent = lamp
		end
	end,

	-- 3 Blumenwiese
	function(folder, plot)
		local rng = Random.new(plot.index * 31)
		local colors = {
			Color3.fromRGB(255, 90, 120), Color3.fromRGB(255, 220, 80), Color3.fromRGB(180, 120, 255),
			Color3.fromRGB(255, 255, 255), Color3.fromRGB(90, 180, 255),
		}
		for _ = 1, 45 do
			local a = rng:NextNumber(0, math.pi * 2)
			local r = rng:NextNumber(26, 34)
			local pos = plot.center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
			vCylinder(folder, 1.2, 0.2, CFrame.new(pos + Vector3.new(0, 0.6, 0)), Color3.fromRGB(60, 140, 60)).CanCollide = false
			ball(folder, 0.8, CFrame.new(pos + Vector3.new(0, 1.3, 0)), colors[rng:NextInteger(1, #colors)]).CanCollide = false
		end
	end,

	-- 4 Wasserfälle: kleine Teiche am Rand, Wasser stürzt als Gischt in die Tiefe
	function(folder, plot)
		for k = 0, 3 do
			local a = k / 4 * math.pi * 2 + 0.4
			local dir = Vector3.new(math.cos(a), 0, math.sin(a))
			local pond = plot.center + dir * 38
			Terrain:FillCylinder(CFrame.new(pond + Vector3.new(0, -1, 0)), 2, 5, Enum.Material.Water)
			local edge = plot.center + dir * (ISLAND_SIZE / 2 + 1)
			local emitterPart = makePart(folder, {
				Size = Vector3.new(6, 0.2, 2),
				CFrame = CFrame.lookAt(edge, edge + dir),
				Transparency = 1,
				CanCollide = false,
				CanQuery = false,
			})
			local water = Instance.new("ParticleEmitter")
			water.Color = ColorSequence.new(Color3.fromRGB(170, 220, 255), Color3.fromRGB(230, 245, 255))
			water.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 5) })
			water.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
			water.Lifetime = NumberRange.new(2, 2.6)
			water.Rate = 70
			water.Speed = NumberRange.new(2, 4)
			water.Acceleration = Vector3.new(0, -25, 0)
			water.SpreadAngle = Vector2.new(10, 10)
			water.EmissionDirection = Enum.NormalId.Front
			water.LightEmission = 0.3
			water.Parent = emitterPart
		end
	end,

	-- 5 Kristalltürme
	function(folder, plot)
		for k = 0, 3 do
			local a = k / 4 * math.pi * 2 + math.pi / 4
			local pos = plot.center + Vector3.new(math.cos(a) * 33, 0, math.sin(a) * 33)
			for j, h in { 18, 11, 8 } do
				local offset = (j == 1) and Vector3.zero or Vector3.new(math.cos(a + j) * 2.5, 0, math.sin(a + j) * 2.5)
				makePart(folder, {
					Size = Vector3.new(3 - j * 0.5, h, 3 - j * 0.5),
					CFrame = CFrame.new(pos + offset + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, math.rad(45), (j - 1) * 0.2),
					Color = Color3.fromRGB(150, 230, 255),
					Material = Enum.Material.Glass,
					Transparency = 0.25,
				})
			end
		end
	end,

	-- 6 Schwebende Mini-Inseln
	function(folder, plot)
		for k = 0, 2 do
			local a = k / 3 * math.pi * 2
			local pos = plot.center + Vector3.new(math.cos(a) * 30, 26 + k * 4, math.sin(a) * 30)
			local model = spinModel(folder, "MiniIsland")
			vCylinder(model, 1.5, 9, CFrame.new(pos), GRASS, Enum.Material.Grass)
			vCylinder(model, 3, 6, CFrame.new(pos - Vector3.new(0, 2, 0)), ROCK, Enum.Material.Rock)
			makePart(model, {
				Size = Vector3.new(1.5, 4, 1.5),
				CFrame = CFrame.new(pos + Vector3.new(0, 2.7, 0)) * CFrame.Angles(0, math.rad(45), 0),
				Color = CRYSTAL_COLOR,
				Material = Enum.Material.Neon,
			})
			model.WorldPivot = CFrame.new(pos)
			CollectionService:AddTag(model, "GenModel")
		end
	end,

	-- 7 Sternenringe um den Kristall
	function(folder, plot)
		for r, height in { [12] = 16, [15] = 21 } do
			local model = spinModel(folder, "StarRing")
			local c = CFrame.new(plot.center + Vector3.new(0, height, 0))
			for k = 0, 23 do
				local a = k / 24 * math.pi * 2
				makePart(model, {
					Size = Vector3.new(0.6, 0.6, 3.4),
					CFrame = c * CFrame.Angles(0, a, 0) * CFrame.new(r, 0, 0),
					Color = Color3.fromRGB(255, 230, 120),
					Material = Enum.Material.Neon,
					CanCollide = false,
				})
			end
			model.WorldPivot = c
			CollectionService:AddTag(model, "GenModel")
		end
	end,

	-- 8 Regenbogen über der Insel
	function(folder, plot)
		local colors = {
			Color3.fromRGB(255, 70, 70), Color3.fromRGB(255, 160, 50), Color3.fromRGB(255, 235, 70),
			Color3.fromRGB(80, 220, 100), Color3.fromRGB(70, 150, 255), Color3.fromRGB(160, 90, 255),
		}
		local toCenter = (Vector3.zero - plot.center).Unit
		local side = Vector3.new(-toCenter.Z, 0, toCenter.X)
		local base = CFrame.fromMatrix(plot.center, side, Vector3.yAxis)
		for band, color in colors do
			local radius = 46 - band * 1.6
			for k = 0, 23 do
				local a = (k + 0.5) / 24 * math.pi
				makePart(folder, {
					Size = Vector3.new(1.6, radius * math.pi / 24 + 0.3, 1.2),
					CFrame = base * CFrame.new(math.cos(a) * radius, math.sin(a) * radius, 0) * CFrame.Angles(0, 0, a),
					Color = color,
					Material = Enum.Material.Neon,
					Transparency = 0.25,
					CanCollide = false,
				})
			end
		end
	end,

	-- 9 Kristallkrone über dem Kristall
	function(folder, plot)
		local model = spinModel(folder, "Crown")
		local c = CFrame.new(plot.center + Vector3.new(0, 26, 0))
		for k = 0, 7 do
			local a = k / 8 * math.pi * 2
			makePart(model, {
				Size = Vector3.new(1.2, 4, 1.2),
				CFrame = c * CFrame.Angles(0, a, 0) * CFrame.new(5, 1.5, 0) * CFrame.Angles(0, math.rad(45), 0),
				Color = GOLD,
				Material = Enum.Material.Neon,
				CanCollide = false,
			})
			ball(model, 1.1, c * CFrame.Angles(0, a, 0) * CFrame.new(5, 4, 0), Color3.fromRGB(255, 80, 160), Enum.Material.Neon).CanCollide = false
		end
		vCylinder(model, 1, 11, c, GOLD, Enum.Material.Neon).CanCollide = false
		model.WorldPivot = c
		CollectionService:AddTag(model, "GenModel")
	end,
}

----------------------------------------------------------------------
-- Insel
----------------------------------------------------------------------

local function buildPlot(index, root)
	local angle = (index - 1) / Config.PLOT_COUNT * math.pi * 2
	local center = Vector3.new(math.cos(angle) * Config.PLOT_RADIUS, 0, math.sin(angle) * Config.PLOT_RADIUS)
	local centerCF = CFrame.new(center)
	local rng = Random.new(index * 7919)

	local folder = Instance.new("Folder")
	folder.Name = "Plot" .. index
	folder:SetAttribute("OwnerId", 0)
	folder.Parent = root

	-- Insel aus natürlichem Gelände
	terrainIsland(center, ISLAND_SIZE / 2, rng)

	-- Bäume am Rand (nicht auf dem Weg zur Brücke)
	local toHub = math.atan2(-center.Z, -center.X)
	for k = 1, 8 do
		local a = toHub + 0.5 + (k - 1) / 8 * (math.pi * 2 - 1)
		local r = rng:NextNumber(37, 42)
		terrainTree(folder, center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r), rng)
	end
	-- ein paar Felsen
	for _ = 1, 4 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(30, 40)
		Terrain:FillBall(center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r), rng:NextNumber(1.8, 3), Enum.Material.Rock)
	end

	-- Sockel und Kristall in der Mitte
	vCylinder(folder, 1.5, 16, centerCF * CFrame.new(0, 0.75, 0), STONE, Enum.Material.Slate)
	vCylinder(folder, 1, 12, centerCF * CFrame.new(0, 2, 0), DARK_STONE, Enum.Material.Slate)

	-- Der große Kristall (Modell aus mehreren Teilen, schwebt über dem Sockel)
	local crystal = Instance.new("Model")
	crystal.Name = "Crystal"
	local crystalCF = centerCF * CFrame.new(0, 11, 0)
	local core = crystalShape(crystal, crystalCF, 6, 9, CRYSTAL_COLOR, Enum.Material.Neon, 0.05)
	crystal.WorldPivot = crystalCF
	crystal.Parent = folder
	CollectionService:AddTag(crystal, "MainCrystal")
	local click = Instance.new("ClickDetector")
	click.MaxActivationDistance = 300
	click.Parent = crystal
	local light = Instance.new("PointLight")
	light.Color = CRYSTAL_COLOR
	light.Range = 26
	light.Brightness = 2
	light.Parent = core

	local burst = Instance.new("ParticleEmitter")
	burst.Name = "Burst"
	burst.Rate = 0
	burst.Color = ColorSequence.new(CRYSTAL_COLOR, Color3.new(1, 1, 1))
	burst.LightEmission = 1
	burst.Size = NumberSequence.new(0.8, 0)
	burst.Lifetime = NumberRange.new(0.5, 0.9)
	burst.Speed = NumberRange.new(14, 24)
	burst.SpreadAngle = Vector2.new(180, 180)
	burst.Parent = core

	local ambient = Instance.new("ParticleEmitter")
	ambient.Name = "Ambient"
	ambient.Rate = 4
	ambient.Color = ColorSequence.new(CRYSTAL_COLOR)
	ambient.LightEmission = 1
	ambient.Size = NumberSequence.new(0.4, 0)
	ambient.Lifetime = NumberRange.new(2, 3)
	ambient.Speed = NumberRange.new(1, 3)
	ambient.SpreadAngle = Vector2.new(180, 180)
	ambient.Parent = core

	-- Kleine Begleitkristalle am Sockel
	for k = 0, 5 do
		local a = k * math.pi / 3
		local tilt = CFrame.Angles(math.sin(a) * 0.45, 0, -math.cos(a) * 0.45)
		local size = (k % 2 == 0) and 1 or 0.75
		crystalShape(folder, centerCF * CFrame.new(math.cos(a) * 5.2, 3.6 * size + 1.2, math.sin(a) * 5.2) * tilt,
			1.8 * size, 3.5 * size, CRYSTAL_COLOR, Enum.Material.Glass, 0.15)
	end

	local signAnchor = makePart(folder, {
		Name = "Sign",
		Size = Vector3.new(1, 1, 1),
		CFrame = centerCF * CFrame.new(0, 18, 0),
		Transparency = 1,
		CanCollide = false,
	})
	local sign = billboard(signAnchor, 14, 3.5, 4, 400)
	sign.Text = "🏝️ Freie Insel"
	sign.Parent.Enabled = false

	-- Sockel für die Helfer im Kreis um den Kristall
	local slots = {}
	for i, gen in Config.GENERATORS do
		local a = (i - 1) / #Config.GENERATORS * math.pi * 2
		local pos = center + Vector3.new(math.cos(a) * SLOT_RADIUS, 0, math.sin(a) * SLOT_RADIUS)
		local base = vCylinder(folder, 1, 9, CFrame.new(pos + Vector3.new(0, 0.5, 0)), DARK_STONE, Enum.Material.Slate)
		local ring = vCylinder(folder, 0.2, 9.6, CFrame.new(pos + Vector3.new(0, 0.1, 0)), STONE, Enum.Material.Neon)
		local top = CFrame.lookAt(pos + Vector3.new(0, 1, 0), center + Vector3.new(0, 1, 0))
		local labelAnchor = makePart(folder, {
			Size = Vector3.new(1, 1, 1),
			CFrame = top * CFrame.new(0, 9, 0),
			Transparency = 1,
			CanCollide = false,
		})
		local label = billboard(labelAnchor, 10, 3, 0, 90)
		local slotFolder = Instance.new("Folder")
		slotFolder.Name = gen.id
		slotFolder.Parent = folder
		slots[gen.id] = { base = base, ring = ring, top = top, label = label, folder = slotFolder, model = nil }
	end

	-- Spawnpunkt am Inselrand mit Blick zum Kristall
	local spawnPos = center + (Vector3.zero - center).Unit * 36 + Vector3.new(0, 4, 0)
	local spawnCF = CFrame.lookAt(spawnPos, center + Vector3.new(0, 4, 0))

	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = folder

	return {
		index = index,
		decor = decor,
		islandLevel = 0,
		rebirths = -1,
		crystalCF = crystalCF,
		core = core,
		folder = folder,
		center = center,
		spawnCF = spawnCF,
		crystal = crystal,
		sign = sign,
		slots = slots,
		owner = nil,
	}
end

----------------------------------------------------------------------
-- Öffentliche Funktionen
----------------------------------------------------------------------

function MapBuilder.build()
	-- Teile der Studio-Vorlage entfernen
	for _, child in workspace:GetChildren() do
		if child.Name == "Baseplate" or child:IsA("SpawnLocation") or child.Name == "Plots" then
			child:Destroy()
		end
	end

	-- Stimmungsvolles Licht
	Lighting.ClockTime = 16.8
	Lighting.Brightness = 2.2
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	local function ensure(className, props)
		local inst = Lighting:FindFirstChildOfClass(className) or Instance.new(className)
		for key, value in props do
			inst[key] = value
		end
		inst.Parent = Lighting
	end
	ensure("Atmosphere", { Density = 0.25, Offset = 0.2, Color = Color3.fromRGB(205, 225, 255), Decay = Color3.fromRGB(140, 160, 210), Glare = 0, Haze = 0.8 })
	ensure("BloomEffect", { Intensity = 0.25, Size = 16, Threshold = 2.6 })
	ensure("ColorCorrectionEffect", { Saturation = 0.15, Contrast = 0.05 })
	ensure("SunRaysEffect", { Intensity = 0.06, Spread = 0.6 })

	-- Kräftige, freundliche Gelände-Farben
	Terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(105, 200, 85))
	Terrain:SetMaterialColor(Enum.Material.LeafyGrass, Color3.fromRGB(70, 165, 70))
	Terrain:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(130, 115, 105))
	Terrain:SetMaterialColor(Enum.Material.Ground, Color3.fromRGB(120, 85, 60))
	Terrain:SetMaterialColor(Enum.Material.Cobblestone, Color3.fromRGB(170, 165, 155))
	Terrain:SetMaterialColor(Enum.Material.Pavement, Color3.fromRGB(185, 180, 170))

	local root = Instance.new("Folder")
	root.Name = "Plots"
	root.Parent = workspace

	for i = 1, Config.PLOT_COUNT do
		local plot = buildPlot(i, root)
		MapBuilder.plots[i] = plot
		MapBuilder.updatePlot(plot, nil)
	end

	-- Echte Roblox-Wolken
	local clouds = Terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
	clouds.Cover = 0.6
	clouds.Density = 0.55
	clouds.Color = Color3.fromRGB(255, 250, 245)
	clouds.Parent = Terrain
end

function MapBuilder.claimPlot(player)
	for _, plot in MapBuilder.plots do
		if not plot.owner then
			plot.owner = player
			plot.folder:SetAttribute("OwnerId", player.UserId)
			plot.sign.Text = "🏝️ " .. player.DisplayName
			plot.sign.Parent.Enabled = true
			return plot
		end
	end
	return nil
end

function MapBuilder.releasePlot(plot)
	plot.owner = nil
	plot.folder:SetAttribute("OwnerId", 0)
	plot.sign.Text = "🏝️ Freie Insel"
	plot.sign.Parent.Enabled = false -- freie Inseln ohne Schild
	MapBuilder.updatePlot(plot, nil)
end

-- Zeigt die gekauften Helfer als Modelle auf den Sockeln an
function MapBuilder.updatePlot(plot, data)
	for i, gen in Config.GENERATORS do
		local slot = plot.slots[gen.id]
		local owned = data and data.gens[gen.id] or 0
		if owned > 0 then
			if not slot.model then
				slot.model = buildGeneratorModel(slot, gen)
				slot.ring.Color = GOLD
				slot.scale = 1
				slot.baseScale = slot.model:GetScale()
			end
			-- Jeder Meilenstein lässt das Modell wachsen
			local scale = 1 + 0.12 * Config.milestonesReached(owned)
			if slot.scale ~= scale then
				slot.model:ScaleTo(slot.baseScale * scale)
				slot.scale = scale
			end
			slot.label.Text = gen.icon .. " " .. gen.name .. "\nx" .. owned
			slot.label.TextColor3 = Color3.new(1, 1, 1)
			slot.label.Parent.Enabled = true
		else
			if slot.model then
				slot.model:Destroy()
				slot.model = nil
			end
			slot.ring.Color = STONE
			local previousOwned = (i == 1) or (data and (data.gens[Config.GENERATORS[i - 1].id] or 0) > 0)
			slot.label.Text = "🔒 " .. gen.name
			slot.label.TextColor3 = Color3.fromRGB(190, 190, 200)
			slot.label.Parent.Enabled = previousOwned and true or false
		end
	end

	-- Ausbaustufen der Insel
	local level = data and Config.islandLevel(data.allTime) or 0
	if level < plot.islandLevel then
		plot.decor:ClearAllChildren()
		Terrain:FillCylinder(CFrame.new(plot.center + Vector3.new(0, -1, 0)), 2, 16.5, Enum.Material.Grass)
		plot.islandLevel = 0
	end
	for i = plot.islandLevel + 1, level do
		local stage = Instance.new("Folder")
		stage.Name = "Level" .. i
		DECOR_BUILDERS[i](stage, plot)
		stage.Parent = plot.decor
	end
	plot.islandLevel = level

	-- Der Kristall wächst mit der Insel, ändert bei Wiedergeburt die Farbe und zeigt den Skin
	local rebirths = data and data.rebirths or 0
	local skinId = data and data.skin or "Default"
	if plot.rebirths ~= rebirths or plot.crystalLevel ~= level or plot.skin ~= skinId then
		plot.rebirths = rebirths
		plot.crystalLevel = level
		plot.skin = skinId
		local skin = Config.SKINS_BY_ID[skinId] or Config.SKINS_BY_ID.Default
		local color = skin.color or Config.rebirthColor(rebirths)
		local material = skin.material == "Glass" and Enum.Material.Glass or Enum.Material.Neon
		local crystal = plot.crystal
		local scale = 1 + 0.07 * level
		crystal:PivotTo(plot.crystalCF)
		crystal:ScaleTo(scale)
		crystal:SetAttribute("BaseScale", scale)
		crystal:SetAttribute("BaseCFrame", plot.crystalCF * CFrame.new(0, 8.4 * (scale - 1), 0))
		crystal:SetAttribute("Rainbow", skin.effect == "rainbow")
		crystal:PivotTo(plot.crystalCF * CFrame.new(0, 8.4 * (scale - 1), 0))
		for _, part in crystal:GetDescendants() do
			if part:IsA("BasePart") then
				part.Color = color
				part.Material = material
				part.Transparency = (material == Enum.Material.Glass) and 0.25 or 0.05
			end
		end
		local core = plot.core
		core.PointLight.Color = color
		core.Burst.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
		core.Ambient.Color = ColorSequence.new(color)

		-- Spezialeffekte der Skins
		for _, name in { "SkinFire", "SkinSparkles" } do
			local old = core:FindFirstChild(name)
			if old then
				old:Destroy()
			end
		end
		if skin.effect == "fire" then
			local fire = Instance.new("Fire")
			fire.Name = "SkinFire"
			fire.Size = 10
			fire.Heat = 12
			fire.Color = Color3.fromRGB(255, 140, 40)
			fire.SecondaryColor = Color3.fromRGB(255, 60, 20)
			fire.Parent = core
		elseif skin.effect == "sparkles" or skin.effect == "rainbow" then
			local sparkles = Instance.new("Sparkles")
			sparkles.Name = "SkinSparkles"
			sparkles.SparkleColor = skin.effect == "rainbow" and Color3.new(1, 1, 1) or color
			sparkles.Parent = core
		end
	end
end

-- Goldener Kristall an einer zufälligen Stelle der Insel
function MapBuilder.spawnGolden(plot)
	local a = math.random() * math.pi * 2
	local r = 8 + math.random() * 26
	local pos = plot.center + Vector3.new(math.cos(a) * r, 3.5, math.sin(a) * r)
	local golden = Instance.new("Model")
	golden.Name = "GoldenCrystal"
	local core = crystalShape(golden, CFrame.new(pos), 2, 2.6, GOLD, Enum.Material.Neon, 0)
	for _, part in golden:GetChildren() do
		part.CanCollide = false
	end
	golden.WorldPivot = CFrame.new(pos)
	golden.Parent = plot.folder
	local light = Instance.new("PointLight")
	light.Color = GOLD
	light.Range = 16
	light.Brightness = 3
	light.Parent = core
	local sparkles = Instance.new("Sparkles")
	sparkles.SparkleColor = GOLD
	sparkles.Parent = core
	local click = Instance.new("ClickDetector")
	click.MaxActivationDistance = 300
	click.Parent = golden
	CollectionService:AddTag(golden, "Golden")
	return golden, click, core
end

-- Bau-Helfer auch für andere Module (Hub-Insel)
MapBuilder.helpers = {
	makePart = makePart,
	vCylinder = vCylinder,
	ball = ball,
	billboard = billboard,
	crystalShape = crystalShape,
	terrainIsland = terrainIsland,
	terrainTree = terrainTree,
	customModel = customModel,
}

return MapBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000007"><Properties><string name="Name">PlayerData</string><ProtectedString name="Source"><![CDATA[-- Spielerdaten: laden, speichern und in der Bestenliste anzeigen.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local PlayerData = {}

local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DATASTORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[Kristall-Imperium] DataStore nicht verfügbar, Fortschritt wird nicht gespeichert:", result)
	end
end

local profiles = {}

local function defaultData()
	return {
		crystals = 0,
		runTotal = 0, -- gesammelt seit der letzten Wiedergeburt
		allTime = 0, -- insgesamt je gesammelt (für die Insel-Ausbaustufen)
		gens = {},
		upgrades = {},
		star = {},
		stardust = 0,
		stardustSpent = 0,
		rebirths = 0,
		lastSeen = 0,
		-- Haustiere: pets = { [uid] = "Cat" / "Cat*" (golden) }, equipped = { uid, ... }
		pets = {},
		equipped = {},
		nextPet = 1,
		-- Skins, Likes, Golem
		skins = { Default = true },
		skin = "Default",
		likes = 0,
		golemKills = 0,
		-- Tägliche Belohnung und Glücksrad
		dailyDay = 0,
		dailyStreak = 0,
		lastSpin = 0,
		-- Robux: bereits verarbeitete Käufe, Gamepässe (werden bei jedem Start neu geprüft)
		receipts = {},
		passes = {},
	}
end

local function keyFor(player)
	return "u_" .. player.UserId
end

local function sanitize(data)
	local clean = defaultData()
	for key, default in clean do
		local value = data[key]
		if type(value) == type(default) then
			clean[key] = value
		end
	end
	return clean
end

function PlayerData.load(player)
	local data = defaultData()
	if store then
		local ok, saved = pcall(store.GetAsync, store, keyFor(player))
		if ok and type(saved) == "table" then
			data = sanitize(saved)
			data.skins.Default = true
		elseif not ok then
			warn("[Kristall-Imperium] Laden fehlgeschlagen für", player.Name, saved)
		end
	end
	profiles[player] = data

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local perSecond = Instance.new("StringValue")
	perSecond.Name = "💎/Sek"
	perSecond.Parent = leaderstats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = leaderstats
	local likes = Instance.new("IntValue")
	likes.Name = "❤️"
	likes.Parent = leaderstats
	leaderstats.Parent = player
	PlayerData.updateLeaderstats(player)

	return data
end

function PlayerData.get(player)
	return profiles[player]
end

function PlayerData.updateLeaderstats(player)
	local data = profiles[player]
	local leaderstats = player:FindFirstChild("leaderstats")
	if not (data and leaderstats) then
		return
	end
	leaderstats["💎/Sek"].Value = Config.format(Config.perSecond(data))
	leaderstats.Rebirths.Value = data.rebirths
	leaderstats["❤️"].Value = data.likes
end

-- Gibt true zurück, wenn gespeichert wurde (oder es keinen DataStore gibt)
function PlayerData.save(player)
	local data = profiles[player]
	if not data then
		return false
	end
	if not store then
		return true
	end
	data.lastSeen = os.time()
	local ok, err = pcall(store.SetAsync, store, keyFor(player), data)
	if not ok then
		warn("[Kristall-Imperium] Speichern fehlgeschlagen für", player.Name, err)
	end
	return ok
end

function PlayerData.release(player)
	PlayerData.save(player)
	profiles[player] = nil
end

function PlayerData.startAutosave()
	task.spawn(function()
		while true do
			task.wait(Config.AUTOSAVE_INTERVAL)
			for player in profiles do
				task.spawn(PlayerData.save, player)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				PlayerData.save(player)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.1)
		end
	end)
end

return PlayerData
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000008"><Properties><string name="Name">Hub</string><ProtectedString name="Source"><![CDATA[-- Hub-Insel in der Mitte: Brücken zu allen Inseln, Eier, Casino, Glücksrad,
-- tägliche Belohnung, Likes und der Kristallgolem.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Hub = {}

local DARK = Color3.fromRGB(70, 70, 85)
local WOOD = Color3.fromRGB(150, 105, 65)
local GOLD = Color3.fromRGB(255, 205, 60)
local CYAN = Color3.fromRGB(90, 200, 255)

local HUB_SPAWN = CFrame.lookAt(Vector3.new(0, 4, 26), Vector3.new(0, 4, 0))

function Hub.init(ctx)
	local h = ctx.MapBuilder.helpers
	local makePart, vCylinder, ball, billboard, crystalShape = h.makePart, h.vCylinder, h.ball, h.billboard, h.crystalShape

	local root = Instance.new("Folder")
	root.Name = "Hub"
	root.Parent = workspace

	local R = Config.HUB_RADIUS

	------------------------------------------------------------------
	-- Insel
	------------------------------------------------------------------
	-- Natürliches Gelände mit gepflastertem Platz in der Mitte
	local terrain = workspace.Terrain
	local rng = Random.new(2024)
	h.terrainIsland(Vector3.zero, R, rng)
	terrain:FillCylinder(CFrame.new(0, -1, 0), 2, 19, Enum.Material.Pavement)
	-- Bäume nur dort, wo keine Brücke und keine Station ist
	for _, deg in { 67.5, 157.5, 247.5, 337.5 } do
		local a = math.rad(deg)
		h.terrainTree(root, Vector3.new(math.cos(a) * (R - 6), 0, math.sin(a) * (R - 6)), rng)
	end
	-- Blumen rund um den Platz
	local flowerColors = { Color3.fromRGB(255, 110, 140), Color3.fromRGB(255, 220, 90), Color3.fromRGB(190, 140, 255), Color3.fromRGB(255, 255, 255) }
	for _ = 1, 70 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(21, R - 4)
		local deg = math.deg(a) % 45
		if deg > 8 and deg < 37 then -- nicht auf den Wegen zu den Brücken
			local pos = Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
			vCylinder(root, 1, 0.2, CFrame.new(pos + Vector3.new(0, 0.5, 0)), Color3.fromRGB(60, 140, 60)).CanCollide = false
			ball(root, 0.7, CFrame.new(pos + Vector3.new(0, 1.1, 0)), flowerColors[rng:NextInteger(1, #flowerColors)]).CanCollide = false
		end
	end
	-- Wege von der Mitte zu den Brücken
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		local from = Vector3.new(math.cos(a) * 17, -1, math.sin(a) * 17)
		local to = Vector3.new(math.cos(a) * (R + 1), -1, math.sin(a) * (R + 1))
		terrain:FillBlock(CFrame.lookAt((from + to) / 2, to), Vector3.new(7, 2, (to - from).Magnitude), Enum.Material.Pavement)
	end
	vCylinder(root, 0.2, 30, CFrame.new(0, 0.1, 0), CYAN, Enum.Material.Neon)
	vCylinder(root, 0.25, 28, CFrame.new(0, 0.15, 0), DARK, Enum.Material.Slate)

	local signAnchor = makePart(root, { Size = Vector3.one, CFrame = CFrame.new(0, 30, 0), Transparency = 1, CanCollide = false })
	billboard(signAnchor, 30, 7, 0, 600).Text = "🌐 HUB-INSEL"

	------------------------------------------------------------------
	-- Brücken zu allen Spieler-Inseln
	------------------------------------------------------------------
	local islandRadius = ctx.MapBuilder.ISLAND_SIZE / 2
	for _, plot in ctx.MapBuilder.plots do
		local dir = Vector3.new(plot.center.X, 0, plot.center.Z).Unit
		local a = dir * (R - 2)
		local b = plot.center - dir * (islandRadius - 2)
		local length = (b - a).Magnitude
		local mid = (a + b) / 2
		local cf = CFrame.lookAt(mid, b)
		makePart(root, {
			Name = "Bridge",
			Size = Vector3.new(7, 0.6, length),
			CFrame = cf * CFrame.new(0, -0.3, 0),
			Color = WOOD,
			Material = Enum.Material.WoodPlanks,
		})
		for _, x in { -3.4, 3.4 } do
			makePart(root, {
				Size = Vector3.new(0.5, 0.5, length),
				CFrame = cf * CFrame.new(x, 1.3, 0),
				Color = Color3.fromRGB(110, 75, 45),
				Material = Enum.Material.Wood,
			})
		end
		-- Schild am Brückenanfang mit dem Namen des Besitzers
		local signPart = makePart(root, { Size = Vector3.one, CFrame = CFrame.new(a + dir * 3 + Vector3.new(0, 6, 0)), Transparency = 1, CanCollide = false })
		local label = billboard(signPart, 7, 1.6, 0, 120)
		local function refresh()
			local owner = plot.owner
			label.Text = owner and ("🏝️ " .. owner.DisplayName) or ""
			label.Parent.Enabled = owner ~= nil
		end
		refresh()
		plot.folder:GetAttributeChangedSignal("OwnerId"):Connect(refresh)
	end

	------------------------------------------------------------------
	-- Stationen (öffnen Fenster auf dem Bildschirm)
	------------------------------------------------------------------
	local function prompt(parent, actionText, objectText, openUI, extra)
		local p = Instance.new("ProximityPrompt")
		p.ActionText = actionText
		p.ObjectText = objectText
		p.HoldDuration = 0
		p.MaxActivationDistance = 12
		p.RequiresLineOfSight = false
		p:SetAttribute("OpenUI", openUI)
		if extra then
			p:SetAttribute("Extra", extra)
		end
		p.Parent = parent
		return p
	end

	local function stationCF(angleDeg, radius)
		local a = math.rad(angleDeg)
		local pos = Vector3.new(math.cos(a) * radius, 0, math.sin(a) * radius)
		return CFrame.lookAt(pos, Vector3.new(0, 0, 0))
	end

	-- Eier
	do
		local base = stationCF(22.5, 30)
		for i, egg in Config.EGGS do
			local cf = base * CFrame.new((i - 2) * 6, 0, 0)
			vCylinder(root, 1.5, 4.5, cf * CFrame.new(0, 0.75, 0), DARK, Enum.Material.Slate)
			local eggPart = makePart(root, {
				Name = "Egg",
				Size = Vector3.new(3, 4, 3),
				CFrame = cf * CFrame.new(0, 3.6, 0),
				Color = egg.color,
				Material = Enum.Material.SmoothPlastic,
			})
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = eggPart
			local light = Instance.new("PointLight")
			light.Color = egg.color
			light.Range = 10
			light.Parent = eggPart
			local label = billboard(eggPart, 7, 2.4, 3.4, 80)
			label.Text = egg.icon .. " " .. egg.name .. "\n💎 " .. Config.format(egg.cost)
			prompt(eggPart, "Ei öffnen", egg.name, "pets", egg.id)
		end
	end

	-- Glücksautomat (Casino)
	do
		local cf = stationCF(112.5, 30)
		makePart(root, { Size = Vector3.new(5, 7, 3.5), CFrame = cf * CFrame.new(0, 3.5, 0), Color = Color3.fromRGB(200, 40, 60), Material = Enum.Material.Metal })
		makePart(root, { Size = Vector3.new(5.6, 1, 4), CFrame = cf * CFrame.new(0, 7.5, 0), Color = GOLD, Material = Enum.Material.Metal })
		local screen = makePart(root, { Size = Vector3.new(4, 2.2, 0.2), CFrame = cf * CFrame.new(0, 4.8, -1.8), Color = Color3.fromRGB(20, 20, 30) })
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.CanvasSize = Vector2.new(300, 160)
		gui.Parent = screen
		local reel = Instance.new("TextLabel")
		reel.Size = UDim2.fromScale(1, 1)
		reel.BackgroundTransparency = 1
		reel.TextScaled = true
		reel.Text = "💎⭐🍀"
		reel.Parent = gui
		vCylinder(root, 3, 0.4, cf * CFrame.new(3, 5, 0), Color3.fromRGB(200, 200, 210), Enum.Material.Metal)
		ball(root, 1, cf * CFrame.new(3, 6.8, 0), Color3.fromRGB(255, 50, 50), Enum.Material.Neon)
		local label = billboard(screen, 10, 2.4, 5, 80)
		label.Text = "🎰 Glücksautomat"
		prompt(screen, "Spielen", "Glücksautomat", "casino")
	end

	-- Glücksrad
	do
		local cf = stationCF(202.5, 30)
		local wheelCF = cf * CFrame.new(0, 7, 0) * CFrame.Angles(0, math.rad(90), 0)
		makePart(root, {
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.8, 11, 11),
			CFrame = wheelCF,
			Color = Color3.fromRGB(40, 40, 60),
			Material = Enum.Material.Metal,
		})
		for k, segment in Config.WHEEL do
			makePart(root, {
				Size = Vector3.new(0.1, 4.6, 3.4),
				CFrame = wheelCF * CFrame.Angles((k - 1) / #Config.WHEEL * math.pi * 2, 0, 0) * CFrame.new(0.45, 2.7, 0),
				Color = segment.color,
				Material = Enum.Material.SmoothPlastic,
			})
		end
		ball(root, 1.6, wheelCF * CFrame.new(0.6, 0, 0), GOLD, Enum.Material.Metal)
		for _, x in { -2.5, 2.5 } do
			makePart(root, { Size = Vector3.new(0.8, 7, 0.8), CFrame = cf * CFrame.new(x, 3.5, 0.8), Color = DARK, Material = Enum.Material.Metal })
		end
		local pointer = makePart(root, { Size = Vector3.new(1, 1.4, 1), CFrame = cf * CFrame.new(0, 13, -0.5), Color = Color3.fromRGB(255, 60, 60), Material = Enum.Material.Neon })
		local label = billboard(pointer, 10, 2.4, 3, 80)
		label.Text = "🎡 Glücksrad"
		prompt(pointer, "Drehen", "Glücksrad", "wheel").MaxActivationDistance = 16
	end

	-- Tägliche Belohnung (Geschenk)
	do
		local cf = stationCF(292.5, 30)
		local box = makePart(root, { Size = Vector3.new(4.5, 4.5, 4.5), CFrame = cf * CFrame.new(0, 2.25, 0), Color = Color3.fromRGB(170, 90, 255) })
		makePart(root, { Size = Vector3.new(4.7, 4.7, 1), CFrame = cf * CFrame.new(0, 2.25, 0), Color = GOLD, Material = Enum.Material.SmoothPlastic })
		makePart(root, { Size = Vector3.new(1, 4.7, 4.7), CFrame = cf * CFrame.new(0, 2.25, 0), Color = GOLD, Material = Enum.Material.SmoothPlastic })
		ball(root, 1.6, cf * CFrame.new(0, 5, 0), GOLD, Enum.Material.SmoothPlastic)
		local label = billboard(box, 10, 2.4, 5, 80)
		label.Text = "🎁 Tägliche Belohnung"
		prompt(box, "Abholen", "Tägliche Belohnung", "daily")
	end

	------------------------------------------------------------------
	-- Teleport zwischen Hub und eigener Insel
	------------------------------------------------------------------
	local teleport = ctx.remote("RemoteEvent", "Teleport")
	teleport.OnServerEvent:Connect(function(player, where)
		local session = ctx.sessions[player]
		local character = player.Character
		if not (session and character) then
			return
		end
		if where == "hub" then
			character:PivotTo(HUB_SPAWN)
		elseif where == "home" then
			character:PivotTo(session.plot.spawnCF)
		end
	end)

	------------------------------------------------------------------
	-- Likes: Herz auf jeder Insel
	------------------------------------------------------------------
	local lastLike = {}
	for _, plot in ctx.MapBuilder.plots do
		local pos = plot.spawnCF * CFrame.new(7, -1.5, 0)
		local heart = ball(plot.folder, 2.6, CFrame.new(pos.Position), Color3.fromRGB(255, 60, 100), Enum.Material.Neon)
		heart.Name = "LikeHeart"
		vCylinder(plot.folder, 1, 3, CFrame.new(pos.Position - Vector3.new(0, 1.8, 0)), DARK, Enum.Material.Slate)
		local likePrompt = prompt(heart, "Insel liken ❤️", "Like", "none")
		likePrompt.Triggered:Connect(function(player)
			local owner = plot.owner
			if not owner then
				ctx.notify(player, "Diese Insel ist noch frei.", "info")
				return
			end
			if owner == player then
				ctx.notify(player, "Das ist deine eigene Insel! Lass sie von anderen liken ❤️", "info")
				return
			end
			local key = player.UserId .. ":" .. owner.UserId
			if lastLike[key] and os.clock() - lastLike[key] < Config.LIKE_COOLDOWN then
				local wait = math.ceil((Config.LIKE_COOLDOWN - (os.clock() - lastLike[key])) / 60)
				ctx.notify(player, "Du kannst diese Insel in " .. wait .. " Min wieder liken.", "error")
				return
			end
			local ownerSession = ctx.sessions[owner]
			local likerSession = ctx.sessions[player]
			if not (ownerSession and likerSession) then
				return
			end
			lastLike[key] = os.clock()

			ownerSession.data.likes += 1
			ownerSession.likeEnd = ctx.now() + Config.LIKE_BOOST_DURATION
			ctx.PlayerData.updateLeaderstats(owner)
			ctx.notify(owner, "❤️ " .. player.DisplayName .. " hat deine Insel geliked! +25 % Produktion für 5 Min", "build")

			local thanks = math.max(100, Config.perSecond(likerSession.data) * 60)
			ctx.earn(likerSession, thanks)
			ctx.notify(player, "❤️ Danke fürs Liken! Du bekommst +" .. Config.format(thanks) .. " 💎", "gold")
			ctx.sendState(owner)
			ctx.sendState(player)
		end)
	end

	------------------------------------------------------------------
	-- Kristallgolem (Gemeinschafts-Boss)
	------------------------------------------------------------------
	local golem = nil

	local function buildGolem()
		local custom = h.customModel("Golem", 18, CFrame.new(0, 0.5, 0))
		local model = custom or Instance.new("Model")
		model.Name = "KristallGolem"
		local head
		if custom then
			-- Unsichtbarer Punkt über dem Modell für die Lebensleiste
			local boxCF, size = custom:GetBoundingBox()
			head = makePart(custom, { Name = "Head", Size = Vector3.one, CFrame = boxCF * CFrame.new(0, size.Y / 2, 0), Transparency = 1, CanCollide = false })
		else
			local rock = Color3.fromRGB(95, 90, 110)
			local base = CFrame.new(0, 0.5, 0)
			for _, x in { -2.5, 2.5 } do
				makePart(model, { Size = Vector3.new(3, 6, 3), CFrame = base * CFrame.new(x, 3, 0), Color = rock, Material = Enum.Material.Slate })
			end
			makePart(model, { Size = Vector3.new(9, 8, 5), CFrame = base * CFrame.new(0, 10, 0), Color = rock, Material = Enum.Material.Slate })
			ball(model, 2.6, base * CFrame.new(0, 10.5, 2.4), CYAN, Enum.Material.Neon)
			head = makePart(model, { Name = "Head", Size = Vector3.new(5, 4, 4.5), CFrame = base * CFrame.new(0, 16, 0), Color = rock, Material = Enum.Material.Slate })
			for _, x in { -1.1, 1.1 } do
				makePart(model, { Size = Vector3.new(0.9, 0.6, 0.2), CFrame = base * CFrame.new(x, 16.5, 2.3), Color = Color3.fromRGB(255, 60, 60), Material = Enum.Material.Neon })
			end
			for _, x in { -6, 6 } do
				makePart(model, { Size = Vector3.new(2.6, 9, 2.6), CFrame = base * CFrame.new(x, 9.5, 0), Color = rock, Material = Enum.Material.Slate })
				crystalShape(model, base * CFrame.new(x, 15.5, 0) * CFrame.Angles(0, 0, x > 0 and -0.4 or 0.4), 1.6, 3, CYAN, Enum.Material.Neon, 0)
			end
			model.WorldPivot = base
		end
		local click = Instance.new("ClickDetector")
		click.MaxActivationDistance = 120
		click.Parent = model

		-- Lebensleiste
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.new(16, 0, 2.4, 0)
		gui.StudsOffset = Vector3.new(0, 5, 0)
		gui.AlwaysOnTop = true
		gui.MaxDistance = 250
		local back = Instance.new("Frame")
		back.Size = UDim2.fromScale(1, 1)
		back.BackgroundColor3 = Color3.fromRGB(30, 10, 15)
		back.Parent = gui
		Instance.new("UICorner").Parent = back
		local fill = Instance.new("Frame")
		fill.Size = UDim2.fromScale(1, 1)
		fill.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
		fill.BorderSizePixel = 0
		fill.Parent = back
		Instance.new("UICorner").Parent = fill
		local text = Instance.new("TextLabel")
		text.Size = UDim2.fromScale(1, 1)
		text.BackgroundTransparency = 1
		text.TextScaled = true
		text.Font = Enum.Font.FredokaOne
		text.TextColor3 = Color3.new(1, 1, 1)
		text.TextStrokeTransparency = 0.3
		text.ZIndex = 2
		text.Parent = back
		gui.Parent = head
		return model, click, fill, text
	end

	local function endGolem(defeated)
		local g = golem
		if not g then
			return
		end
		golem = nil
		local pos = g.model:GetPivot().Position + Vector3.new(0, 8, 0)
		g.model:Destroy()

		if not defeated then
			ctx.notifyAll("💨 Der Kristallgolem ist entkommen! Beim nächsten Mal schneller sein.", "info")
			return
		end

		local boom = Instance.new("Explosion")
		boom.Position = pos
		boom.BlastPressure = 0
		boom.DestroyJointRadiusPercent = 0
		boom.BlastRadius = 12
		boom.Parent = workspace

		local total, participants, mvp, mvpDamage = 0, 0, nil, 0
		for player, damage in g.damage do
			total += damage
			participants += 1
			if damage > mvpDamage then
				mvp, mvpDamage = player, damage
			end
		end
		for player, damage in g.damage do
			local session = ctx.sessions[player]
			if session then
				local data = session.data
				local share = damage / math.max(total, 1)
				local reward = math.max(Config.perSecond(data) * Config.GOLEM_REWARD_SECONDS, Config.clickValue(data) * 300, 200) * (0.5 + share)
				ctx.earn(session, reward)
				data.golemKills += 1
				local message = "⚔️ Golem besiegt! Deine Beute: +" .. Config.format(reward) .. " 💎"
				if player == mvp and participants >= 2 then
					data.stardust += 1
					message ..= " und +1 ✨ (MVP!)"
				end
				ctx.notify(player, message, "gold")
				ctx.sendState(player)
			end
		end
		if mvp then
			ctx.notifyAll("🏆 Der Kristallgolem wurde besiegt! MVP: " .. mvp.DisplayName, "frenzy")
		end
	end

	local function spawnGolem()
		local totalClick = 0
		for _, session in ctx.sessions do
			totalClick += Config.clickValue(session.data)
		end
		local maxHp = math.max(100, totalClick * Config.GOLEM_HP_CLICKS * 0.6)
		local model, click, fill, text = buildGolem()
		golem = { model = model, hp = maxHp, maxHp = maxHp, damage = {} }
		local g = golem

		local function updateBar()
			fill.Size = UDim2.fromScale(math.clamp(g.hp / g.maxHp, 0, 1), 1)
			text.Text = "⚔️ " .. Config.format(math.max(g.hp, 0)) .. " / " .. Config.format(g.maxHp)
			model:SetAttribute("HP", g.hp)
		end
		model:SetAttribute("MaxHP", maxHp)
		model:SetAttribute("EndsAt", ctx.now() + Config.GOLEM_DURATION)
		updateBar()
		model.Parent = root
		CollectionService:AddTag(model, "Golem")

		click.MouseClick:Connect(function(player)
			local session = ctx.sessions[player]
			if golem ~= g or not session or session.tokens < 1 then
				return
			end
			session.tokens -= 1
			local damage = Config.clickValue(session.data) * ctx.boost(session)
			g.hp -= damage
			g.damage[player] = (g.damage[player] or 0) + damage
			updateBar()
			if g.hp <= 0 then
				endGolem(true)
			end
		end)

		ctx.notifyAll("⚠️ Ein KRISTALLGOLEM greift die Hub-Insel an! Besiegt ihn gemeinsam!", "frenzy")
		task.delay(Config.GOLEM_DURATION, function()
			if golem == g then
				endGolem(false)
			end
		end)
	end

	task.spawn(function()
		while true do
			task.wait(Config.GOLEM_INTERVAL)
			if not golem and next(ctx.sessions) then
				spawnGolem()
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		if golem then
			golem.damage[player] = nil
		end
	end)
end

return Hub
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000009"><Properties><string name="Name">Pets</string><ProtectedString name="Source"><![CDATA[-- Haustiere (Eier, Ausrüsten, Verschmelzen) und Robux-Shop (Developer Products, Gamepässe).

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Pets = {}
local ctx = nil

local function countPets(data)
	local n = 0
	for _ in data.pets do
		n += 1
	end
	return n
end

-- Zeigt die ausgerüsteten Haustiere allen Spielern (die Clients bauen die 3D-Modelle)
local function updateAttribute(player, data)
	local list = {}
	for _, uid in data.equipped do
		if data.pets[uid] then
			table.insert(list, data.pets[uid])
		end
	end
	player:SetAttribute("Pets", table.concat(list, ","))
end

local function changed(player, session)
	updateAttribute(player, session.data)
	ctx.PlayerData.updateLeaderstats(player)
	ctx.sendState(player)
end

local function addPet(data, entry)
	local uid = "p" .. data.nextPet
	data.nextPet += 1
	data.pets[uid] = entry
	return uid
end

local function unequip(data, uid)
	for i, equippedUid in data.equipped do
		if equippedUid == uid then
			table.remove(data.equipped, i)
			return true
		end
	end
	return false
end

local function isEquipped(data, uid)
	return table.find(data.equipped, uid) ~= nil
end

local function rollEgg(egg)
	local total = 0
	for _, option in egg.pets do
		total += option.chance
	end
	local roll = math.random() * total
	for _, option in egg.pets do
		roll -= option.chance
		if roll <= 0 then
			return option.pet
		end
	end
	return egg.pets[1].pet
end

-- Öffnet ein Ei. free = true für Belohnungen (Glücksrad).
function Pets.hatch(player, session, eggId, free)
	local egg = Config.EGGS_BY_ID[eggId]
	local data = session.data
	if not egg then
		return false, "Unbekanntes Ei."
	end
	if countPets(data) >= Config.MAX_PETS then
		return false, "Dein Inventar ist voll (" .. Config.MAX_PETS .. "). Lass ein paar Haustiere frei."
	end
	if not free then
		if data.crystals < egg.cost then
			return false, "Nicht genug Kristalle."
		end
		data.crystals -= egg.cost
	end
	local petId = rollEgg(egg)
	local uid = addPet(data, petId)
	-- Automatisch ausrüsten, wenn noch Platz ist
	if #data.equipped < Config.maxEquipped(data) then
		table.insert(data.equipped, uid)
	end
	local pet = Config.PETS_BY_ID[petId]
	if pet.rarity == "Legendary" then
		ctx.notifyAll("🌟 " .. player.DisplayName .. " hat " .. pet.icon .. " " .. pet.name .. " (Legendär) geschlüpft!", "frenzy")
	end
	changed(player, session)
	return true, petId
end

function Pets.give(player, session, petId)
	addPet(session.data, petId)
	changed(player, session)
end

function Pets.onJoin(player, session)
	local data = session.data
	-- Kaputte Einträge aufräumen
	for uid, entry in data.pets do
		if not Config.parsePet(entry) then
			data.pets[uid] = nil
		end
	end
	for i = #data.equipped, 1, -1 do
		if not data.pets[data.equipped[i]] then
			table.remove(data.equipped, i)
		end
	end

	-- Gamepässe neu prüfen
	data.passes = {}
	for _, pass in Config.GAMEPASSES do
		if pass.passId and pass.passId > 0 then
			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.passId)
			if ok and owns then
				data.passes[pass.key] = true
			end
		end
	end
	while #data.equipped > Config.maxEquipped(data) do
		table.remove(data.equipped)
	end
	updateAttribute(player, data)
end

function Pets.init(context)
	ctx = context

	local petAction = ctx.remote("RemoteFunction", "PetAction")
	petAction.OnServerInvoke = function(player, action, arg)
		local session = ctx.sessions[player]
		if not session then
			return false, "Fehler."
		end
		local data = session.data

		if action == "hatch" and type(arg) == "string" then
			return Pets.hatch(player, session, arg, false)

		elseif action == "equip" and type(arg) == "string" then
			if not data.pets[arg] then
				return false, "Unbekanntes Haustier."
			end
			if isEquipped(data, arg) then
				unequip(data, arg)
				changed(player, session)
				return true, "Abgelegt."
			end
			if #data.equipped >= Config.maxEquipped(data) then
				return false, "Alle Plätze belegt (" .. Config.maxEquipped(data) .. "). Leg erst ein Haustier ab."
			end
			table.insert(data.equipped, arg)
			changed(player, session)
			return true, "Ausgerüstet!"

		elseif action == "best" then
			local list = {}
			for uid, entry in data.pets do
				table.insert(list, { uid = uid, boost = Config.petBoost(entry) })
			end
			table.sort(list, function(a, b)
				return a.boost > b.boost
			end)
			data.equipped = {}
			for i = 1, math.min(#list, Config.maxEquipped(data)) do
				table.insert(data.equipped, list[i].uid)
			end
			changed(player, session)
			return true, "Die besten Haustiere sind ausgerüstet!"

		elseif action == "release" and type(arg) == "string" then
			if not data.pets[arg] then
				return false, "Unbekanntes Haustier."
			end
			unequip(data, arg)
			data.pets[arg] = nil
			changed(player, session)
			return true, "Freigelassen. Tschüss! 👋"

		elseif action == "merge" then
			-- 3 gleiche normale Haustiere -> 1 goldenes
			local groups = {}
			for uid, entry in data.pets do
				local _, golden = Config.parsePet(entry)
				if not golden then
					groups[entry] = groups[entry] or {}
					table.insert(groups[entry], uid)
				end
			end
			local bestId, bestBoost = nil, -1
			for entry, uids in groups do
				if #uids >= 3 and Config.petBoost(entry) > bestBoost then
					bestId, bestBoost = entry, Config.petBoost(entry)
				end
			end
			if not bestId then
				return false, "Du brauchst 3 gleiche Haustiere zum Verschmelzen."
			end
			for i = 1, 3 do
				local uid = groups[bestId][i]
				unequip(data, uid)
				data.pets[uid] = nil
			end
			local newUid = addPet(data, bestId .. "*")
			if #data.equipped < Config.maxEquipped(data) then
				table.insert(data.equipped, newUid)
			end
			changed(player, session)
			local pet = Config.PETS_BY_ID[bestId]
			return true, "✨ Goldener " .. pet.name .. " erschaffen! (Bonus x" .. Config.GOLDEN_PET_FACTOR .. ")"
		end
		return false, "Fehler."
	end

	------------------------------------------------------------------
	-- Robux: Developer Products
	------------------------------------------------------------------
	local productsById = {}
	for _, product in Config.PRODUCTS do
		if product.productId and product.productId > 0 then
			productsById[product.productId] = product
		end
	end

	MarketplaceService.ProcessReceipt = function(receipt)
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		local session = player and ctx.sessions[player]
		local product = productsById[receipt.ProductId]
		if not (session and product) then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local data = session.data
		if data.receipts[receipt.PurchaseId] then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end

		local reward = product.reward
		if reward.kind == "pet" then
			addPet(data, reward.pet)
			if #data.equipped < Config.maxEquipped(data) then
				local newest = "p" .. (data.nextPet - 1)
				table.insert(data.equipped, newest)
			end
		elseif reward.kind == "skin" then
			data.skins[reward.skin] = true
			data.skin = reward.skin
			ctx.MapBuilder.updatePlot(session.plot, data)
		elseif reward.kind == "frenzy" then
			session.frenzyEnd = math.max(session.frenzyEnd, ctx.now()) + reward.seconds
		end

		-- Kauf merken, damit er nie doppelt gutgeschrieben wird (max. 100 Einträge)
		data.receipts[receipt.PurchaseId] = os.time()
		local count, oldestId, oldestTime = 0, nil, math.huge
		for id, time in data.receipts do
			count += 1
			if time < oldestTime then
				oldestId, oldestTime = id, time
			end
		end
		if count > 100 and oldestId then
			data.receipts[oldestId] = nil
		end

		changed(player, session)
		ctx.notify(player, "🛍️ Danke für deinen Kauf: " .. product.icon .. " " .. product.name .. "!", "gold")
		if not ctx.PlayerData.save(player) then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	------------------------------------------------------------------
	-- Robux: Gamepässe
	------------------------------------------------------------------
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local session = ctx.sessions[player]
		if not (purchased and session) then
			return
		end
		for _, pass in Config.GAMEPASSES do
			if pass.passId == passId then
				session.data.passes[pass.key] = true
				ctx.notify(player, "🎉 " .. pass.icon .. " " .. pass.name .. " ist jetzt aktiv!", "gold")
				changed(player, session)
			end
		end
	end)
end

return Pets
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000A"><Properties><string name="Name">Fun</string><ProtectedString name="Source"><![CDATA[-- Tägliche Belohnung, Glücksrad, Glücksautomat (nur Kristalle) und Kristall-Skins.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Pets = require(script.Parent.Pets)

local Fun = {}

local function minutesOfProduction(data, minutes)
	return math.max(Config.DAILY_MIN, Config.perSecond(data) * 60 * minutes)
end

local function today()
	return math.floor(os.time() / 86400)
end

function Fun.init(ctx)
	------------------------------------------------------------------
	-- Tägliche Belohnung
	------------------------------------------------------------------
	local daily = ctx.remote("RemoteFunction", "ClaimDaily")
	daily.OnServerInvoke = function(player)
		local session = ctx.sessions[player]
		if not session then
			return false, "Fehler."
		end
		local data = session.data
		local day = today()
		if data.dailyDay == day then
			return false, "Heute schon abgeholt. Komm morgen wieder! 🌙"
		end
		local streak = (data.dailyDay == day - 1) and (data.dailyStreak % #Config.DAILY_REWARDS) + 1 or 1
		local amount = minutesOfProduction(data, Config.DAILY_REWARDS[streak])
		ctx.earn(session, amount)
		local message = "🎁 Tag " .. streak .. ": +" .. Config.format(amount) .. " 💎"
		if streak == #Config.DAILY_REWARDS then
			data.stardust += 1
			message ..= " und +1 ✨ Sternenstaub!"
		end
		data.dailyDay = day
		data.dailyStreak = streak
		ctx.sendState(player)
		return true, message
	end

	------------------------------------------------------------------
	-- Glücksrad (kostenlos alle paar Stunden)
	------------------------------------------------------------------
	local wheel = ctx.remote("RemoteFunction", "SpinWheel")
	wheel.OnServerInvoke = function(player)
		local session = ctx.sessions[player]
		if not session then
			return false, "Fehler."
		end
		local data = session.data
		local left = Config.WHEEL_COOLDOWN - (os.time() - data.lastSpin)
		if left > 0 then
			return false, "Nächster Dreh in " .. math.ceil(left / 60) .. " Min."
		end
		data.lastSpin = os.time()

		local total = 0
		for _, segment in Config.WHEEL do
			total += segment.weight
		end
		local roll = math.random() * total
		local index = #Config.WHEEL
		for i, segment in Config.WHEEL do
			roll -= segment.weight
			if roll <= 0 then
				index = i
				break
			end
		end

		local segment = Config.WHEEL[index]
		local message
		if segment.kind == "minutes" then
			local amount = minutesOfProduction(data, segment.value)
			ctx.earn(session, amount)
			message = "🎡 Gewonnen: +" .. Config.format(amount) .. " 💎"
		elseif segment.kind == "frenzy" then
			session.frenzyEnd = math.max(session.frenzyEnd, ctx.now()) + segment.value
			message = "🎡 Gewonnen: Kristallrausch für " .. segment.value .. " Sekunden! 🔥"
		elseif segment.kind == "egg" then
			local ok, petId = Pets.hatch(player, session, segment.value, true)
			if ok then
				local pet = Config.PETS_BY_ID[petId]
				message = "🎡 Gewonnen: " .. pet.icon .. " " .. pet.name .. "!"
			else
				local amount = minutesOfProduction(data, 15)
				ctx.earn(session, amount)
				message = "🎡 Inventar voll – stattdessen +" .. Config.format(amount) .. " 💎"
			end
		elseif segment.kind == "stardust" then
			data.stardust += segment.value
			message = "🎡 Gewonnen: +" .. segment.value .. " ✨ Sternenstaub!"
		end
		if segment.kind == "minutes" and segment.value >= 180 then
			ctx.notifyAll("🎰 " .. player.DisplayName .. " hat den JACKPOT am Glücksrad geknackt!", "frenzy")
		end
		ctx.sendState(player)
		return true, message, index
	end

	------------------------------------------------------------------
	-- Glücksautomat: Einsatz in Kristallen, ca. 95 % Auszahlung
	------------------------------------------------------------------
	local lastSlot = {}
	local slots = ctx.remote("RemoteFunction", "PlaySlots")
	slots.OnServerInvoke = function(player, fraction)
		local session = ctx.sessions[player]
		if not session or not table.find(Config.SLOT_BETS, fraction) then
			return false, "Fehler."
		end
		if lastSlot[player] and os.clock() - lastSlot[player] < 1.5 then
			return false, "Nicht so schnell! 🎰"
		end
		local data = session.data
		local bet = math.floor(data.crystals * fraction)
		if bet < Config.SLOT_MIN_BET then
			return false, "Du brauchst mindestens " .. Config.SLOT_MIN_BET .. " 💎 Einsatz."
		end
		lastSlot[player] = os.clock()

		local symbols = {}
		for i = 1, 3 do
			symbols[i] = Config.SLOT_SYMBOLS[math.random(1, #Config.SLOT_SYMBOLS)]
		end
		local multiplier = 0
		if symbols[1] == symbols[2] and symbols[2] == symbols[3] then
			multiplier = Config.SLOT_TRIPLE[symbols[1]]
		elseif symbols[1] == symbols[2] or symbols[2] == symbols[3] or symbols[1] == symbols[3] then
			multiplier = Config.SLOT_PAIR
		end
		local payout = math.floor(bet * multiplier)
		-- Gewinne zählen nicht für Wiedergeburt oder Insel-Ausbau
		data.crystals += payout - bet

		local message
		if multiplier >= 8 then
			message = "🎉 MEGA-GEWINN! +" .. Config.format(payout) .. " 💎"
			ctx.notifyAll("🎰 " .. player.DisplayName .. " hat am Glücksautomaten " .. Config.format(payout) .. " 💎 gewonnen!", "frenzy")
		elseif multiplier > 0 then
			message = "Gewonnen: " .. Config.format(payout) .. " 💎 (x" .. multiplier .. ")"
		else
			message = "Leider nichts. -" .. Config.format(bet) .. " 💎"
		end
		ctx.sendState(player)
		return true, message, symbols, payout - bet
	end

	------------------------------------------------------------------
	-- Skins: freischalten und ausrüsten
	------------------------------------------------------------------
	local skinRemote = ctx.remote("RemoteFunction", "Skin")
	skinRemote.OnServerInvoke = function(player, skinId)
		local session = ctx.sessions[player]
		local skin = type(skinId) == "string" and Config.SKINS_BY_ID[skinId]
		if not (session and skin) then
			return false, "Fehler."
		end
		local data = session.data
		if not Config.skinUnlocked(data, skin) then
			local unlock = skin.unlock
			if unlock.kind == "crystals" then
				if data.crystals < unlock.cost then
					return false, "Nicht genug Kristalle."
				end
				data.crystals -= unlock.cost
			elseif unlock.kind == "robux" then
				return false, "Diesen Skin gibt es im 🛍️ Robux-Shop."
			else
				return false, "Noch gesperrt: " .. Config.skinRequirement(skin)
			end
		end
		data.skins[skin.id] = true
		data.skin = skin.id
		ctx.MapBuilder.updatePlot(session.plot, data)
		ctx.sendState(player)
		return true, skin.icon .. " " .. skin.name .. " ist jetzt aktiv!"
	end
end

return Fun
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000000000000000000000000000010"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX0000000000000000000000000000000F"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX0000000000000000000000000000000D"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[-- Kristall-Imperium: Oberfläche, Shop, Effekte (Client).

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local mineEvent = remotes:WaitForChild("Mine")
local stateEvent = remotes:WaitForChild("State")
local notifyEvent = remotes:WaitForChild("Notify")
local buyFunction = remotes:WaitForChild("Buy")
local rebirthFunction = remotes:WaitForChild("Rebirth")

local player = Players.LocalPlayer
local format = Config.format

-- Farben ---------------------------------------------------------------

local C = {
	panel = Color3.fromRGB(18, 20, 38),
	card = Color3.fromRGB(34, 38, 66),
	cardLocked = Color3.fromRGB(26, 28, 46),
	text = Color3.fromRGB(240, 244, 255),
	muted = Color3.fromRGB(160, 168, 200),
	cyan = Color3.fromRGB(90, 200, 255),
	gold = Color3.fromRGB(255, 205, 60),
	green = Color3.fromRGB(60, 200, 110),
	grey = Color3.fromRGB(80, 84, 110),
	purple = Color3.fromRGB(170, 110, 255),
	red = Color3.fromRGB(255, 90, 80),
	orange = Color3.fromRGB(255, 140, 40),
}

-- Zustand vom Server -----------------------------------------------------

local state = nil
local stateClock = 0
local clientTokens = Config.CLICKS_PER_SECOND

local function frenzyLeft()
	if not state then
		return 0
	end
	return math.max(0, (state.frenzyEnd or 0) - workspace:GetServerTimeNow())
end

local function likeLeft()
	if not state then
		return 0
	end
	return math.max(0, (state.likeEnd or 0) - workspace:GetServerTimeNow())
end

-- Kristallrausch und Like-Boost
local function frenzyMult()
	if not state then
		return 1
	end
	return Config.tempMultiplier(state, workspace:GetServerTimeNow())
end

local function perSecond()
	return state and Config.perSecond(state) * frenzyMult() or 0
end

-- Kristalle inkl. Vorhersage seit dem letzten Server-Update
local function currentCrystals()
	if not state then
		return 0
	end
	return state.crystals + perSecond() * (os.clock() - stateClock)
end

-- Sounds (eingebaute Roblox-Sounds) --------------------------------------

local function makeSound(id, volume)
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume
	sound.Parent = script
	return sound
end
local sounds = {
	click = makeSound("rbxasset://sounds/clickfast.wav", 0.35),
	buy = makeSound("rbxasset://sounds/electronicpingshort.wav", 0.45),
	big = makeSound("rbxasset://sounds/swoosh.wav", 0.6),
}
local function play(name)
	SoundService:PlayLocalSound(sounds[name])
end

-- UI-Helfer ---------------------------------------------------------------

local function create(className, props, parent)
	local inst = Instance.new(className)
	for key, value in props do
		inst[key] = value
	end
	inst.Parent = parent
	return inst
end

local function corner(parent, radius)
	create("UICorner", { CornerRadius = UDim.new(0, radius or 12) }, parent)
end

local function stroke(parent, color, thickness, transparency)
	create("UIStroke", {
		Color = color,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

local function padding(parent, px)
	create("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
	}, parent)
end

local function text(props, parent)
	local base = {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextColor3 = C.text,
		TextScaled = true,
		RichText = true,
	}
	for key, value in props do
		base[key] = value
	end
	return create("TextLabel", base, parent)
end

local function button(props, parent)
	local base = {
		Font = Enum.Font.FredokaOne,
		TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true,
		AutoButtonColor = true,
		BackgroundColor3 = C.green,
	}
	for key, value in props do
		base[key] = value
	end
	local b = create("TextButton", base, parent)
	corner(b, 10)
	return b
end

local function hex(color)
	local function byte(x)
		return math.clamp(math.floor(x * 255 + 0.5), 0, 255)
	end
	return string.format("#%02X%02X%02X", byte(color.R), byte(color.G), byte(color.B))
end

-- Fortschrittsbalken: gibt Funktion set(Anteil, Text) zurück
local function progressBar(props, parent, fillColor)
	local bar = create("Frame", props, parent)
	bar.BackgroundColor3 = Color3.fromRGB(12, 14, 26)
	corner(bar, 8)
	local fill = create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = fillColor,
		BorderSizePixel = 0,
	}, bar)
	corner(fill, 8)
	local label = text({
		Size = UDim2.fromScale(1, 1),
		Font = Enum.Font.GothamBold,
		ZIndex = 2,
	}, bar)
	create("UIPadding", { PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2) }, label)
	return function(alpha, caption)
		fill.Size = UDim2.fromScale(math.clamp(alpha, 0, 1), 1)
		label.Text = caption
	end, bar
end

-- Bildschirm -------------------------------------------------------------

local gui = create("ScreenGui", {
	Name = "KristallHUD",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, player:WaitForChild("PlayerGui"))

-- Alles passt sich der Bildschirmgröße an (auch Handy)
local scaled = {}
local function autoScale(guiObject)
	table.insert(scaled, create("UIScale", {}, guiObject))
end

---------------------------------------------------------------------------
-- Oben: Kristallanzeige
---------------------------------------------------------------------------

local top = create("Frame", {
