	Position = UDim2.new(0.5, 0, 1, -104),
	Size = UDim2.fromOffset(460, 50),
	BackgroundColor3 = Color3.fromRGB(150, 30, 40),
	Visible = false,
}, gui)
corner(golemBanner, 14)
